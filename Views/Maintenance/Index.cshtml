@model IReadOnlyList<GoodHotel.Models.ViewModels.MaintenanceListItem>

@{
    if (User.IsInRole("Admin")) { Layout = "_AdminLayout"; }
    ViewData["Title"] = "Maintenance Reports";
}

<section class="content-section">
    <div class="container">
        <div class="section-heading">
            <span class="eyebrow text-dark">Hotel Operations</span>
            <h2>Maintenance Reports</h2>
        </div>

        <div class="alert alert-warning" role="status">
            Unresolved reports block the room. Existing bookings are not cancelled.
        </div>
        @if (TempData["MaintenanceSuccess"] is string success)
        {
            <div class="alert alert-success" role="status">@success</div>
        }

        @if (User.IsInRole("Staff") || User.IsInRole("Housekeeper"))
        {
            <a asp-action="Create" class="btn btn-primary mb-3">Create report</a>
        }

        @if (Model.Count == 0)
        {
            <div class="alert alert-light border" role="status">No maintenance reports found.</div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table align-middle">
                    <thead>
                        <tr>
                            <th>Report ID</th>
                            <th>Room</th>
                            <th>Status</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var report in Model)
                        {
                            <tr>
                                <td>@report.ReportId</td>
                                <td>@(string.IsNullOrWhiteSpace(report.RoomNumber) ? "Not specified" : report.RoomNumber)</td>
                                <td>@report.Status</td>
                                <td><a asp-action="Details" asp-route-id="@report.ReportId" class="btn btn-sm btn-outline-primary">Details</a></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</section>
