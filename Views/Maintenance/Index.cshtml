@model IReadOnlyList<GoodHotel.Models.ViewModels.MaintenanceListItem>

@{
    ViewData["Title"] = "แจ้งซ่อม";
    var canReport = User.IsInRole("Staff") || User.IsInRole("Housekeeper");
}

@section Actions {
    @if (canReport)
    {
        <a asp-action="Create" class="btn btn-primary btn-sm">แจ้งอุปกรณ์ชำรุด</a>
    }
}

<p class="text-muted mb-3">ห้องที่มีงานซ่อมค้างจะถูกปิดไม่ให้จองใหม่ (การจองที่มีอยู่แล้วไม่ถูกยกเลิก)</p>

@if (TempData["MaintenanceSuccess"] is string success)
{
    <div class="alert alert-success" role="status">@success</div>
}

<section class="table-panel">
    <div class="panel-head">
        <h2>รายการแจ้งซ่อม</h2>
        <span class="text-muted small">@Model.Count(r => r.Status != "Resolved") รายการที่ยังไม่เสร็จ</span>
    </div>
    @if (Model.Count == 0)
    {
        <p class="panel-empty">ยังไม่มีรายการแจ้งซ่อม</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover">
                <thead><tr><th>เลขที่</th><th>ห้อง</th><th>ปัญหา</th><th>แจ้งเมื่อ</th><th>สถานะ</th><th></th></tr></thead>
                <tbody>
                    @foreach (var report in Model)
                    {
                        <tr>
                            <td>#@report.ReportId</td>
                            <td>@ThaiText.OrDash(report.RoomNumber)</td>
                            <td class="text-break">@(report.Description.Length > 80 ? report.Description[..80] + "…" : report.Description)</td>
                            <td class="num">@ThaiText.Time(report.ReportedAtUtc)<div class="text-muted small">@ThaiText.OrDash(report.ReportedBy)</div></td>
                            <td><span class="badge @ThaiText.Badge(report.Status)">@ThaiText.Status(report.Status)</span></td>
                            <td class="text-end"><a asp-action="Details" asp-route-id="@report.ReportId" class="btn btn-sm btn-outline-primary">ดูรายละเอียด</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>
