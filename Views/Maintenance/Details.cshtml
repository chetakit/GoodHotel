@model GoodHotel.Models.ViewModels.MaintenanceDetailsViewModel

@{
    ViewData["Title"] = $"งานซ่อม #{Model.ReportId}";
}

<section class="content-section">
    <div class="container">
        @if (TempData["MaintenanceSuccess"] is string success)
        {
            <div class="alert alert-success" role="status">@success</div>
        }
        @if ((ViewData["MaintenanceError"] ?? TempData["MaintenanceError"]) is string error)
        {
            <div class="alert alert-danger" role="alert">@error</div>
        }

        <div class="booking-panel mb-4">
            <dl class="row mb-0">
                <dt class="col-sm-5 col-lg-4">ห้อง</dt>
                <dd class="col-sm-7 col-lg-8">@ThaiText.OrDash(Model.RoomNumber)</dd>
                <dt class="col-sm-5 col-lg-4">รายละเอียดปัญหา</dt>
                <dd class="col-sm-7 col-lg-8">@Model.Description</dd>
                <dt class="col-sm-5 col-lg-4">สถานะ</dt>
                <dd class="col-sm-7 col-lg-8">@ThaiText.Status(Model.Status)</dd>
                <dt class="col-sm-5 col-lg-4">แจ้งโดย</dt>
                <dd class="col-sm-7 col-lg-8">@(await Users.NameAsync(Model.ReportedByUserId))</dd>
                <dt class="col-sm-5 col-lg-4">ปิดห้องระหว่างซ่อม</dt>
                <dd class="col-sm-7 col-lg-8">@(Model.BlocksRoom ? "ปิด" : "ไม่ปิด")</dd>
                <dt class="col-sm-5 col-lg-4">ปิดห้องตั้งแต่</dt>
                <dd class="col-sm-7 col-lg-8">@(Model.BlockFrom.HasValue ? ThaiText.Date(Model.BlockFrom) : "ไม่กำหนด")</dd>
                <dt class="col-sm-5 col-lg-4">ปิดห้องถึง (ไม่รวมวันนี้)</dt>
                <dd class="col-sm-7 col-lg-8">@(Model.BlockUntil.HasValue ? ThaiText.Date(Model.BlockUntil) : "ไม่กำหนด")</dd>
                @if (Model.Status == "Resolved")
                {
                    <dt class="col-sm-5 col-lg-4">ปิดงานโดย</dt>
                    <dd class="col-sm-7 col-lg-8">@(await Users.NameAsync(Model.ResolvedByUserId))</dd>
                    <dt class="col-sm-5 col-lg-4">บันทึกการซ่อม</dt>
                    <dd class="col-sm-7 col-lg-8">@Model.ResolutionNote</dd>
                    <dt class="col-sm-5 col-lg-4">ซ่อมเสร็จเมื่อ</dt>
                    <dd class="col-sm-7 col-lg-8">@ThaiText.Time(Model.ResolvedAtUtc)</dd>
                }
            </dl>
        </div>

        @if (User.IsInRole("Admin") && Model.Status == "Open")
        {
            <div class="booking-panel mb-4">
                <h3 class="h5">ความคืบหน้า</h3>
                <form asp-action="StartProgress" method="post">
                    <input type="hidden" name="id" value="@Model.ReportId" />
                    <button type="submit" class="btn btn-primary">เริ่มซ่อม</button>
                </form>
            </div>
        }
        @if (User.IsInRole("Admin") && Model.Status == "In Progress")
        {
            <div class="booking-panel">
                <h3 class="h5">ปิดงานซ่อม</h3>
                <form asp-action="Resolve" method="post">
                    <input type="hidden" name="id" value="@Model.ReportId" />
                    <label for="resolutionNote" class="form-label">บันทึกการซ่อม</label>
                    <textarea id="resolutionNote" name="resolutionNote" class="form-control mb-3" rows="4" maxlength="2000" required></textarea>
                    <button type="submit" class="btn btn-primary">ซ่อมเสร็จแล้ว</button>
                </form>
            </div>
        }

        <div class="booking-panel mt-4">
            <h3 class="h5">ประวัติสถานะ</h3>
            @if (Model.Events.Count == 0)
            {
                <p class="text-muted mb-0">ไม่มีประวัติ (รายการแจ้งซ่อมเก่า)</p>
            }
            else
            {
                <ul class="mb-0">
                    @foreach (var entry in Model.Events)
                    {
                        <li>
                            @ThaiText.Time(entry.OccurredAtUtc) —
                            @(entry.FromStatus == null ? "สร้างรายการ" : ThaiText.Status(entry.FromStatus)) → @ThaiText.Status(entry.ToStatus)
                            · โดย @(await Users.NameAsync(entry.ActorUserId))
                            @if (!string.IsNullOrWhiteSpace(entry.Note))
                            {
                                <span> — @entry.Note</span>
                            }
                        </li>
                    }
                </ul>
            }
        </div>

        <a asp-action="Index" class="btn btn-outline-primary mt-4">กลับไปรายการแจ้งซ่อม</a>
    </div>
</section>
