@model GoodHotel.Models.ViewModels.MaintenanceCreateViewModel

@{
    ViewData["Title"] = "Create Maintenance Report";
}

<section class="content-section">
    <div class="container">
        <div class="section-heading">
            <span class="eyebrow text-dark">Hotel Operations</span>
            <h2>Create Maintenance Report</h2>
        </div>
        <div class="alert alert-warning" role="status">
            A new report blocks the room immediately. Existing bookings are not cancelled; notify an Admin.
        </div>
        <div class="booking-panel">
            <form asp-action="Create" method="post">
                <div asp-validation-summary="All" class="text-danger"></div>
                <div class="mb-3">
                    <label asp-for="RoomId" class="form-label">Room</label>
                    <select asp-for="RoomId" asp-items="Model.Rooms" class="form-select">
                        <option value="">Select a room</option>
                    </select>
                    <span asp-validation-for="RoomId" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Description" class="form-label">Issue details</label>
                    <textarea asp-for="Description" class="form-control" rows="5" maxlength="2000"></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>
                <button type="submit" class="btn btn-primary">Submit report</button>
                <a asp-action="Index" class="btn btn-outline-primary">Back to reports</a>
            </form>
        </div>
    </div>
</section>
