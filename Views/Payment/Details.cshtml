@model GoodHotel.Models.ViewModels.PaymentDetailsViewModel
@{
    if (User.IsInRole("Admin")) { Layout = "_AdminLayout"; }
    ViewData["Title"] = "Booking Payment";
    var culture = System.Globalization.CultureInfo.InvariantCulture;
    var confirmed = Model.Payments.Any(p => p.IsVerified);
    var pending = Model.Payments.Any(p => p.IsNew && !p.IsVerified && (p.Status == "Pending" || p.Status == "Submitted"));
}
<section class="content-section"><div class="container">
    <h2>Payment for booking #@Model.BookingId</h2>
    @if (TempData["PaymentSuccess"] is string success) { <div class="alert alert-success">@success</div> }
    @if (TempData["PaymentError"] is string error) { <div class="alert alert-danger" role="alert">@error</div> }
    @if (Model.RequiresReconciliation)
    {
        <div class="alert alert-warning">Historical payment records require review before the balance or further payments can be confirmed.</div>
    }
    <p>Booking amount: @(Model.BookingAmount?.ToString("N2", culture) ?? "Not specified")</p>
    <p>Confirmed: @Model.ConfirmedAmount.ToString("N2", culture) · Refunded: @Model.RefundedAmount.ToString("N2", culture)</p>
    <p>Outstanding: @(Model.RequiresReconciliation || !Model.BookingAmount.HasValue ? "Requires review" : (Model.BookingAmount.Value - Model.ConfirmedAmount + Model.RefundedAmount).ToString("N2", culture))</p>
    @if (confirmed) { <p>No further payment can be confirmed for this booking, including after a refund.</p> }

    @if (User.IsInRole("Customer") && !Model.RequiresReconciliation && !confirmed && !pending && Model.BookingAmount > 0)
    {
        <h3>Pay the full amount</h3>
        <partial name="~/Views/Payment/_PaymentMethodForm.cshtml" model="Model.BookingId" />
    }
    else if (pending && User.IsInRole("Customer")) { <p>A payment is awaiting confirmation; cash is confirmed after receipt at the hotel.</p> }

    <h3>Payments</h3>
    @if (Model.Payments.Count == 0) { <p>No payment records.</p> }
    @foreach (var payment in Model.Payments)
    {
        <div class="booking-panel mb-3">
            <p>Payment #@payment.PaymentId · @(payment.Method == "Cash" ? "Cash at Hotel" : payment.Method ?? "Unknown method") · @payment.DisplayStatus · @(payment.Amount?.ToString("N2", culture) ?? "Unknown amount")</p>
            @if (GoodHotel.Services.PaymentService.IsMockMethod(payment.Method))
            {
                <p>DEMO/MOCK only; no real payment was transferred.</p>
            }
            @if (payment.HasEvidence) { <a asp-action="Evidence" asp-route-id="@payment.PaymentId" target="_blank" rel="noopener">View evidence</a> }
            @if ((User.IsInRole("Staff") || User.IsInRole("Admin")) && payment.IsLegacy)
            {
                <form asp-action="Reconcile" method="post" class="mt-3">
                    <input type="hidden" name="bookingId" value="@Model.BookingId" /><input type="hidden" name="paymentId" value="@payment.PaymentId" />
                    <input type="hidden" name="key" value="@Guid.NewGuid().ToString("N")" />
                    <label>Evidence reviewed and reconciliation reason</label><textarea name="reason" class="form-control" maxlength="2000" required></textarea>
                    <button class="btn btn-primary mt-2" name="confirmed" value="true" type="submit">Confirm actual full payment</button>
                    <button class="btn btn-outline-danger mt-2" name="confirmed" value="false" type="submit">Exclude as not paid</button>
                </form>
            }
            @if ((User.IsInRole("Staff") || User.IsInRole("Admin")) && payment.IsNew && !payment.IsVerified &&
                (payment.Status == "Pending" || payment.Status == "Submitted"))
            {
                    <form asp-action="Review" method="post" class="mt-3">
                        <input type="hidden" name="bookingId" value="@Model.BookingId" /><input type="hidden" name="paymentId" value="@payment.PaymentId" />
                        <input type="hidden" name="confirm" value="true" /><input type="hidden" name="key" value="@Guid.NewGuid().ToString("N")" />
                        <label>Actual amount received after independent verification</label>
                        <input name="received" type="number" step="0.01" min="0.01" class="form-control" required />
                        <button class="btn btn-primary mt-2" type="submit">Confirm full payment</button>
                    </form>
                <form asp-action="Review" method="post" class="mt-3">
                    <input type="hidden" name="bookingId" value="@Model.BookingId" /><input type="hidden" name="paymentId" value="@payment.PaymentId" />
                    <input type="hidden" name="confirm" value="false" /><input type="hidden" name="key" value="@Guid.NewGuid().ToString("N")" />
                    <label>Rejection reason</label><textarea name="reason" class="form-control" maxlength="2000" required></textarea>
                    <button class="btn btn-outline-danger mt-2" type="submit">Reject</button>
                </form>
            }
            @if (User.IsInRole("Customer") && payment.IsVerified && payment.Amount > 0 &&
                !Model.Refunds.Any(r => r.PaymentId == payment.PaymentId && r.Status == "Requested"))
            {
                <form asp-action="RequestRefund" method="post" class="mt-3">
                    <input type="hidden" name="bookingId" value="@Model.BookingId" /><input type="hidden" name="paymentId" value="@payment.PaymentId" />
                    <input type="hidden" name="key" value="@Guid.NewGuid().ToString("N")" />
                    <label>Refund amount</label><input name="amount" type="number" min="0.01" step="0.01" class="form-control" required />
                    <label>Reason</label><textarea name="reason" class="form-control" maxlength="2000" required></textarea>
                    <button class="btn btn-outline-primary mt-2" type="submit">Request refund</button>
                </form>
            }
        </div>
    }
    <h3>Refunds</h3>
    @if (Model.Refunds.Count == 0) { <p>No refunds.</p> }
    @foreach (var refund in Model.Refunds)
    {
        <div class="booking-panel mb-3">
            <p>Refund #@refund.RefundId · Payment #@refund.PaymentId · @refund.Amount.ToString("N2", culture) · @refund.Status</p>
            <p>@refund.Reason</p>
            @if (User.IsInRole("Admin") && refund.Status == "Requested")
            {
                <form asp-action="ApproveRefund" method="post">
                    <input type="hidden" name="bookingId" value="@Model.BookingId" /><input type="hidden" name="refundId" value="@refund.RefundId" />
                    <input type="hidden" name="key" value="@Guid.NewGuid().ToString("N")" />
                    @if (GoodHotel.Services.PaymentService.IsMockMethod(Model.Payments.FirstOrDefault(p => p.PaymentId == refund.PaymentId)?.Method))
                    {
                        <label><input type="checkbox" name="actualRefundSent" value="true" required /> I confirm this is a DEMO refund; no real money is transferred.</label>
                    }
                    else
                    {
                        <label><input type="checkbox" name="actualRefundSent" value="true" required /> I confirm this refund has actually been sent.</label>
                    }
                    <button class="btn btn-primary" type="submit">Approve and record refund</button>
                </form>
                <form asp-action="RejectRefund" method="post" class="mt-3">
                    <input type="hidden" name="bookingId" value="@Model.BookingId" /><input type="hidden" name="refundId" value="@refund.RefundId" />
                    <input type="hidden" name="key" value="@Guid.NewGuid().ToString("N")" />
                    <label>Rejection reason</label><textarea name="reason" class="form-control" maxlength="2000" required></textarea>
                    <button class="btn btn-outline-danger mt-2" type="submit">Reject refund request</button>
                </form>
            }
        </div>
    }
    <h3>Payment history</h3>
    @if (Model.Events.Count == 0) { <p>No payment events.</p> }
    @foreach (var item in Model.Events)
    {
        <p>Payment #@item.PaymentId · @item.EventType · @item.OccurredAtUtc.ToString("yyyy-MM-dd HH:mm", culture) UTC · Actor #@item.ActorUserId · @item.Amount?.ToString("N2", culture) · @item.Method · @item.Reason</p>
    }
</div></section>
