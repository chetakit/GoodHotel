@* รายการชำระเงินทั้งหมด (พนักงาน/บัญชี) *@
@model GoodHotel.Models.ViewModels.PaymentQueueViewModel
@{
    var isAccountant = User.IsInRole("Accountant");
    // พนักงานต้อนรับใช้ดูว่าการจองไหนจ่ายแล้ว/คืนเงินแล้ว (ลูกค้าชำระออนไลน์ ยืนยันอัตโนมัติ) ฝ่ายบัญชีใช้ตรวจและพิจารณาคืนเงิน
    ViewData["Title"] = isAccountant ? "รายการชำระเงิน" : "สถานะการชำระเงิน";

    string Badge(string status) => status switch
    {
        "Paid" => "text-bg-success",
        "Submitted" or "Pending" or "Requires reconciliation" => "text-bg-warning",
        "Rejected" => "text-bg-danger",
        _ => "text-bg-secondary"
    };
}

@if (Model.Refunds.Count > 0)
{
    <section class="table-panel mb-3" id="refunds">
        <div class="panel-head">
            <h2>คำขอคืนเงินรอพิจารณา (@Model.Refunds.Count)</h2>
            @if (!isAccountant)
            {
                <span class="text-muted small">ฝ่ายบัญชีเป็นผู้พิจารณา</span>
            }
        </div>
        <div class="table-responsive">
            <table class="table">
                <thead><tr><th>คำขอ</th><th>การจอง</th><th>เหตุผล</th><th>ขอเมื่อ</th><th class="text-end">จำนวนเงิน</th><th></th></tr></thead>
                <tbody>
                    @foreach (var refund in Model.Refunds)
                    {
                        <tr>
                            <td>#@refund.RefundId</td>
                            <td>@(refund.BookingId.HasValue ? $"#{refund.BookingId}" : "-")</td>
                            <td>@ThaiText.OrDash(refund.Reason)</td>
                            <td class="num">@ThaiText.Time(refund.RequestedAtUtc)</td>
                            <td class="text-end num">฿@refund.Amount.ToString("N2")</td>
                            <td class="text-end">
                                @if (refund.BookingId.HasValue)
                                {
                                    <a class="btn btn-sm @(isAccountant ? "btn-primary" : "btn-outline-primary")"
                                       asp-action="Details" asp-route-id="@refund.BookingId" asp-fragment="refund">@(isAccountant ? "พิจารณา" : "ดู")</a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
}

<form asp-action="Queue" method="get" class="toolbar">
    <div>
        <label for="search" class="form-label">ค้นหา</label>
        <input id="search" name="search" value="@Model.Search" maxlength="100" class="form-control"
               placeholder="เลขที่การจอง ชื่อ หรืออีเมลลูกค้า" />
    </div>
    <div>
        <label for="status" class="form-label">สถานะ</label>
        <select id="status" name="status" class="form-select" onchange="this.form.submit()">
            <option value="">ทุกสถานะ</option>
            @foreach (var value in new[] { "Submitted", "Pending", "Paid", "Refunded", "Rejected", "Cancelled", "Requires reconciliation", "Excluded" })
            {
                <option value="@value" selected="@(Model.Status == value)">@ThaiText.Status(value)</option>
            }
        </select>
    </div>
    <div>
        <label for="method" class="form-label">ช่องทาง</label>
        <select id="method" name="method" class="form-select" onchange="this.form.submit()">
            <option value="">ทุกช่องทาง</option>
            @foreach (var value in new[] { "Cash", "Bank Transfer (Mock)", "PromptPay (Mock)", "PayPal (Mock)" })
            {
                <option value="@value" selected="@(Model.Method == value)">@ThaiText.PaymentMethod(value)</option>
            }
        </select>
    </div>
    <button type="submit" class="btn btn-primary">ค้นหา</button>
    @if (!string.IsNullOrEmpty(Model.Search) || !string.IsNullOrEmpty(Model.Status) || !string.IsNullOrEmpty(Model.Method))
    {
        <a asp-action="Queue" class="btn btn-outline-secondary">ล้างตัวกรอง</a>
    }
</form>

<section class="table-panel">
    <div class="panel-head">
        <h2>การชำระเงิน</h2>
        <span class="text-muted small">@Model.Payments.Count รายการ · (จำลอง) = ไม่มีเงินจริง</span>
    </div>
    @if (Model.Payments.Count == 0)
    {
        <p class="panel-empty">ไม่พบรายการชำระเงิน</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover">
                <thead><tr><th>การจอง</th><th>ลูกค้า</th><th>ช่องทาง</th><th>สถานะ</th><th>วันที่ทำรายการ</th><th class="text-end">จำนวนเงิน</th><th></th></tr></thead>
                <tbody>
                    @foreach (var item in Model.Payments)
                    {
                        var status = item.Payment.DisplayStatus;
                        <tr>
                            <td>@(item.Payment.BookingId.HasValue ? $"#{item.Payment.BookingId}" : "-")</td>
                            <td>@ThaiText.OrDash(item.Customer)</td>
                            <td>@ThaiText.PaymentMethod(item.Payment.Method)</td>
                            <td><span class="badge @Badge(status)">@ThaiText.Status(status)</span></td>
                            <td class="num">@(item.TransactionAtUtc.HasValue ? ThaiText.Time(item.TransactionAtUtc) : ThaiText.Date(item.PaymentDate))</td>
                            <td class="text-end num">@(item.Payment.Amount.HasValue ? $"฿{item.Payment.Amount:N2}" : "-")</td>
                            <td class="text-end">
                                @if (item.Payment.BookingId.HasValue)
                                {
                                    <a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-id="@item.Payment.BookingId">
                                        @(status is "Submitted" or "Pending" or "Requires reconciliation" ? "ตรวจสอบ" : "ดู")
                                    </a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>
