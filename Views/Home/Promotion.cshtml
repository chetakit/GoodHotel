@model IReadOnlyList<GoodHotel.Models.ViewModels.PromotionListViewModel>

@{
    ViewData["Title"] = "Promotion";
}

<section class="content-section">
    <div class="container">
        <div class="section-heading">
            <span class="eyebrow text-dark">Special Offers</span>
            <h2>Promotion ของ Good Hotel</h2>
            <p>ไม่ต้องกรอกโค้ด ระบบจะเลือกโปรที่คุ้มที่สุดให้อัตโนมัติตอนจอง (1 การจองใช้ได้ 1 โปร)</p>
        </div>

        @if (Model.Count == 0)
        {
            <div class="promo-card text-center">
                <h4>ยังไม่มีโปรโมชั่น</h4>
                <p class="text-muted mb-0">ขณะนี้ยังไม่มีข้อเสนอพิเศษ</p>
            </div>
        }
        else
        {
            <div class="row g-4">
                @foreach (var promotion in Model)
                {
                    <div class="col-lg-4 col-md-6">
                        <partial name="_PromotionCard" model="promotion" />
                    </div>
                }
            </div>
        }

        <div class="text-center mt-5">
            <a asp-action="Rooms" class="btn btn-primary hotel-primary-btn">ค้นหาห้องพัก</a>
        </div>
    </div>
</section>
