@model IReadOnlyList<GoodHotel.Models.ViewModels.MyBookingViewModel>

@{
    ViewData["Title"] = "การจองของฉัน";
    var upcoming = Model.Where(b => !b.IsHistory).ToList();
    var history = Model.Where(b => b.IsHistory).ToList();
}

<section class="content-section">
    <div class="container">
        <div class="section-heading">
            <h2>การจองของฉัน</h2>
            <p>รายการห้องพักที่จองไว้กับ Good Hotel</p>
        </div>

        @if (TempData["BookingSuccess"] is string success)
        {
            <div class="alert alert-success" role="status">@success</div>
        }
        @if (TempData["BookingError"] is string error)
        {
            <div class="alert alert-warning" role="alert">@error</div>
        }
        @if (ViewData["RefundNotices"] is int refundNotices && refundNotices > 0)
        {
            <div class="alert alert-info" role="status">
                ฝ่ายบัญชีพิจารณาคำขอคืนเงินของคุณแล้ว @refundNotices รายการ ดูผลได้ที่การ์ดการจองด้านล่าง
            </div>
        }

        @if (Model.Count == 0)
        {
            <div class="feature-box text-center py-5">
                <div class="feature-icon mx-auto">⌂</div>
                <h3 class="mb-3">ยังไม่มีประวัติการจอง</h3>
                <p class="text-muted mb-4">เลือกห้องพักและวันที่เข้าพักที่เหมาะกับคุณเพื่อเริ่มต้นการเดินทาง</p>
                <div class="d-flex flex-column flex-sm-row justify-content-center gap-2">
                    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-primary hotel-secondary-btn">กลับหน้า Home</a>
                    <a asp-controller="Home" asp-action="Rooms" class="btn btn-primary hotel-primary-btn">ค้นหาห้องพัก</a>
                </div>
            </div>
        }
        else
        {
            <ul class="nav nav-pills mb-4" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active" data-bs-toggle="pill" data-bs-target="#tab-upcoming"
                            type="button" role="tab">การจองปัจจุบัน (@upcoming.Count)</button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" data-bs-toggle="pill" data-bs-target="#tab-history"
                            type="button" role="tab">ประวัติการเข้าพัก (@history.Count)</button>
                </li>
            </ul>

            <div class="tab-content">
                <div class="tab-pane fade show active" id="tab-upcoming" role="tabpanel">
                    @if (upcoming.Count == 0)
                    {
                        <div class="feature-box">
                            <p class="mb-2">ไม่มีการจองที่กำลังจะมาถึง</p>
                            <a asp-controller="Home" asp-action="Rooms" class="btn btn-primary btn-sm">ค้นหาห้องว่าง</a>
                        </div>
                    }
                    <div class="row g-4">
                        @foreach (var booking in upcoming)
                        {
                            <div class="col-12"><partial name="_MyBookingCard" model="booking" /></div>
                        }
                    </div>
                </div>

                <div class="tab-pane fade" id="tab-history" role="tabpanel">
                    @if (history.Count == 0)
                    {
                        <div class="feature-box text-muted">ยังไม่มีประวัติการเข้าพัก</div>
                    }
                    <div class="row g-4">
                        @foreach (var booking in history)
                        {
                            <div class="col-12"><partial name="_MyBookingCard" model="booking" /></div>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
</section>
