@model GoodHotel.Models.ViewModels.BookingConfirmationViewModel

@{
    ViewData["Title"] = "ยืนยันการจอง";
    var culture = System.Globalization.CultureInfo.InvariantCulture;
}

<section class="content-section">
    <div class="container">
        <div class="section-heading">
            <h2>ตรวจสอบและยืนยันการจอง</h2>
        </div>

        @if (Model.IsSaved)
        {
            <div class="booking-panel summary-card">
                <h4 class="mb-3">@Model.StatusMessage</h4>
                <div class="summary-line">
                    <span>เลขที่การจอง</span>
                    <strong>@Model.SavedBookingId</strong>
                </div>
                <div class="summary-line">
                    <span>ยอดที่บันทึก</span>
                    <strong>฿@Model.EstimatedAmount?.ToString("N2")</strong>
                </div>
                <div class="summary-line">
                    <span>เตียงเสริม</span>
                    <strong>@Model.ExtraBedCount เตียง</strong>
                </div>
                @if (Model.RoomSubtotal.HasValue)
                {
                    <div class="summary-line">
                        <span>ค่าห้อง</span>
                        <strong>฿@Model.RoomSubtotal.Value.ToString("N2")</strong>
                    </div>
                    <div class="summary-line">
                        <span>ส่วนลดโปรโมชัน</span>
                        <strong>฿@((Model.DiscountAmount ?? 0m).ToString("N2"))</strong>
                    </div>
                    <div class="summary-line">
                        <span>ค่าเตียงเสริม</span>
                        <strong>฿@((Model.ExtraBedAmount ?? 0m).ToString("N2"))</strong>
                    </div>
                    <div class="summary-line">
                        <span>ยอดรวม</span>
                        <strong>฿@Model.TotalAmount?.ToString("N2")</strong>
                    </div>
                }
                @if (Model.PromotionName != null)
                {
                    <div class="summary-line">
                        <span>โปรโมชัน</span>
                        <strong>@Model.PromotionName</strong>
                    </div>
                }
                <p class="text-muted mt-3 mb-0">สถานะการชำระเงิน: @ThaiText.Status(Model.PaymentStatus)</p>
                @if (Model.IsMockPayment)
                {
                    <p class="text-muted mb-0">การชำระเงินจำลอง ไม่มีการโอนเงินจริง</p>
                }
            </div>
            <div class="mt-3"><partial name="_PaymentDeadline" model="Model.PaymentDueAtUtc" /></div>
            @if (Model.CanSubmitPayment && Model.SavedBookingId.HasValue)
            {
                <div data-hide-on-expire>
                    <partial name="~/Views/Payment/_PaymentMethodForm.cshtml" model="Model.SavedBookingId.Value" />
                </div>
                <form asp-controller="Home" asp-action="CancelBooking" method="post" class="cancel-strip mt-3"
                      onsubmit="return confirm('ยกเลิกการจอง #@Model.SavedBookingId แล้วไปเลือกห้องอื่น?');">
                    <input type="hidden" name="bookingId" value="@Model.SavedBookingId" />
                    <input type="hidden" name="findAnotherRoom" value="true" />
                    <span class="text-muted small">จองผิดห้อง หรืออยากได้ห้องอื่น? ยกเลิกได้เลย ยังไม่มีค่าใช้จ่าย</span>
                    <button type="submit" class="btn btn-sm btn-outline-danger">ยกเลิกแล้วเลือกห้องอื่น</button>
                </form>
            }
            else if (Model.SavedBookingId.HasValue)
            {
                <a asp-controller="Payment" asp-action="Details" asp-route-id="@Model.SavedBookingId"
                   class="btn btn-outline-primary mt-3">ดูการชำระเงิน</a>
            }
        }
        else
        {
            <div class="row g-4">
                <div class="col-lg-7">
                    <div class="booking-panel">
                        <h4 class="mb-4">รายละเอียดการจอง</h4>

                        @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
                        {
                            <div class="alert alert-warning" role="alert">
                                @Model.StatusMessage
                            </div>
                        }

                        <div asp-validation-summary="All" class="text-danger mb-3"></div>

                        @if (Model.RoomNumber != null)
                        {
                            <dl class="row mb-0">
                                <dt class="col-sm-5">ห้อง</dt>
                                <dd class="col-sm-7">@Model.RoomType - @Model.RoomNumber</dd>
                                <dt class="col-sm-5">ราคา</dt>
                                <dd class="col-sm-7">@(Model.Rate.HasValue ? $"฿{Model.Rate.Value:N2} / คืน" : "ไม่ระบุ")</dd>
                                <dt class="col-sm-5">รับได้</dt>
                                <dd class="col-sm-7">@(Model.Capacity?.ToString() ?? "ไม่ระบุ") คน</dd>
                                <dt class="col-sm-5">วันเข้าพัก</dt>
                                <dd class="col-sm-7">@ThaiText.Date(Model.CheckIn)</dd>
                                <dt class="col-sm-5">วันออก</dt>
                                <dd class="col-sm-7">@ThaiText.Date(Model.CheckOut)</dd>
                                <dt class="col-sm-5">ผู้เข้าพัก</dt>
                                <dd class="col-sm-7">@Model.Guests</dd>
                            </dl>
                        }
                        else
                        {
                            <p class="text-muted">
                                กรุณาค้นหาห้องว่างและเลือกวันที่เข้าพักก่อนดำเนินการยืนยัน
                            </p>
                        }
                    </div>
                </div>

                <div class="col-lg-5">
                    <div class="booking-panel summary-card">
                        <h4 class="mb-3">สรุปยอด</h4>
                        @if (Model.RoomSubtotal.HasValue)
                        {
                            <div class="summary-line">
                                <span>ราคาห้อง</span>
                                <strong>฿@Model.Rate?.ToString("N2") x @Model.NightCount คืน</strong>
                            </div>
                            <div class="summary-line">
                                <span>ค่าห้อง</span>
                                <strong id="booking-room-subtotal">฿@Model.RoomSubtotal.Value.ToString("N2")</strong>
                            </div>
                            <div class="summary-line">
                                <span>
                                    ส่วนลดโปรโมชัน
                                    <small class="d-block text-muted" id="booking-promotion-name">@(Model.PromotionName ?? "ไม่เข้าเงื่อนไขโปร")</small>
                                </span>
                                <strong id="booking-discount">-฿@((Model.DiscountAmount ?? 0m).ToString("N2"))</strong>
                            </div>
                            <div class="summary-line">
                                <span>ค่าเตียงเสริม</span>
                                <strong id="booking-extra-bed-amount">฿@((Model.ExtraBedAmount ?? 0m).ToString("N2"))</strong>
                            </div>
                            <div class="summary-line fw-bold">
                                <span>ยอดรวม</span>
                                <strong id="booking-total-amount">฿@Model.TotalAmount?.ToString("N2")</strong>
                            </div>
                        }
                        else
                        {
                            <p class="text-muted mb-0">
                                ยังไม่สามารถคำนวณยอดได้ กรุณาตรวจสอบข้อมูลการเข้าพัก
                            </p>
                        }

                        @if (User.IsInRole("Customer") && Model.RoomNumber != null)
                        {
                            <form id="promotion-preview-form"
                                  data-apply-url="@Url.Action("ApplyPromotion", "Home")"
                                  data-currency="฿">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="RoomId" value="@Model.RoomId" />
                                <input type="hidden"
                                       name="CheckIn"
                                       value="@Model.CheckIn?.ToString("yyyy-MM-dd", culture)" />
                                <input type="hidden"
                                       name="CheckOut"
                                       value="@Model.CheckOut?.ToString("yyyy-MM-dd", culture)" />
                                <input type="hidden" name="Guests" value="@Model.Guests" />

                                <div class="mt-4">
                                    <label for="booking-extra-bed-count" class="form-label">
                                        เตียงเสริม (สูงสุด 1 เตียง)
                                    </label>
                                    <select asp-for="ExtraBedCount"
                                            id="booking-extra-bed-count"
                                            class="form-select">
                                        <option value="0">0</option>
                                        <option value="1">1</option>
                                    </select>
                                    <small class="text-muted">
                                        ฿500 / เตียง / คืน และเพิ่มความจุได้ 1 คน
                                    </small>
                                </div>

                                @* เลือกโปรเอง: มีเฉพาะโปรที่การจองนี้ใช้ได้ ค่าเริ่มต้นคือโปรที่ลดได้มากที่สุด (server ตรวจซ้ำตอนบันทึก) *@
                                @if (Model.AvailablePromotions.Count > 0)
                                {
                                    <div class="mt-3">
                                        <label for="booking-promotion-select" class="form-label">โปรโมชัน (ใช้ได้ 1 โปรต่อการจอง)</label>
                                        <select id="booking-promotion-select" name="PromotionId" class="form-select">
                                            @foreach (var promo in Model.AvailablePromotions)
                                            {
                                                <option value="@promo.PromotionId" selected="@(promo.PromotionId == Model.PromotionId)">
                                                    @promo.Name — ลด ฿@promo.DiscountAmount.ToString("N0")@(promo.DiscountAmount == Model.AvailablePromotions[0].DiscountAmount ? " (คุ้มที่สุด)" : "")
                                                </option>
                                            }
                                        </select>
                                    </div>
                                }

                                <div id="booking-promotion-feedback"
                                     class="small mt-2 @(Model.PromotionName != null ? "promotion-feedback-success" : "text-muted")"
                                     role="status"
                                     aria-live="polite">
                                    @(Model.PromotionName == null
                                        ? "การจองนี้ยังไม่เข้าเงื่อนไขโปรโมชัน"
                                        : Model.AvailablePromotions.Count > 1
                                            ? $"เลือกโปร \"{Model.PromotionName}\" ซึ่งลดได้มากที่สุดไว้ให้แล้ว เปลี่ยนได้"
                                            : $"ใช้โปร \"{Model.PromotionName}\"")
                                </div>
                            </form>

                        }

                        @if (Model.CanConfirm)
                        {
                            @if (User.IsInRole("Customer"))
                            {
                                <form id="booking-confirm-form"
                                      asp-controller="Home"
                                      asp-action="Booking"
                                      method="post">
                                    @Html.AntiForgeryToken()
                                    <input asp-for="RoomId" type="hidden" />
                                    <input asp-for="CheckIn" type="hidden" />
                                    <input asp-for="CheckOut" type="hidden" />
                                    <input asp-for="Guests" type="hidden" />
                                    <input asp-for="ExtraBedCount" type="hidden" />
                                    <input asp-for="PromotionId" type="hidden" />
                                    <button type="submit"
                                            class="btn btn-primary w-100 mt-3"
                                            data-booking-confirm>
                                        ยืนยันการจอง
                                    </button>
                                    <p class="small text-muted mt-2 mb-0">
                                        ต้องชำระเงินภายใน @GoodHotel.Services.PaymentDeadline.Window.TotalMinutes นาทีหลังจอง ·
                                        ยังไม่จ่ายยกเลิกได้ฟรี · ชำระแล้วขอคืนเงินได้ (ฝ่ายบัญชีพิจารณา) หรือยกเลิกเองแบบไม่คืนเงิน
                                    </p>
                                </form>
                            }
                            else if (User.Identity?.IsAuthenticated == true)
                            {
                                <p class="text-muted mt-3 mb-0">
                                    กรุณาเข้าสู่ระบบด้วยบัญชีลูกค้าเพื่อยืนยันการจอง
                                </p>
                            }
                            else
                            {
                                <a asp-controller="Home"
                                   asp-action="Login"
                                   class="btn btn-primary w-100 mt-3">
                                    เข้าสู่ระบบเพื่อยืนยันการจอง
                                </a>
                            }
                        }
                        else
                        {
                            <p class="text-muted mb-0">
                                ยังไม่สามารถยืนยันการจองได้ กรุณาตรวจสอบข้อมูลหรือค้นหาห้องว่างอีกครั้ง
                            </p>
                            <a asp-controller="Home"
                               asp-action="Rooms"
                               class="btn btn-outline-primary w-100 mt-3">
                                กลับไปค้นหาห้อง
                            </a>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
</section>
