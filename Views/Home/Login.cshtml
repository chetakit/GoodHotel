@* หน้าเข้าสู่ระบบ: ฟอร์มส่งไป HomeController.Login [POST] *@
@{
    ViewData["Title"] = "เข้าสู่ระบบ";
}

<section class="content-section">
    <div class="container">
        <div class="auth-card">
            <ul class="nav nav-pills nav-fill mb-4">
                <li class="nav-item">
                    <a class="nav-link active" asp-controller="Home" asp-action="Login">เข้าสู่ระบบ</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-controller="Home" asp-action="Register" asp-route-returnUrl="@ViewBag.ReturnUrl">สมัครสมาชิก</a>
                </li>
            </ul>

            <h2 class="h4 mb-1">เข้าสู่ระบบ</h2>
            <p class="text-muted small mb-3">ลูกค้าและพนักงานใช้หน้านี้เหมือนกัน ระบบจะพาไปหน้าของแต่ละคนเอง</p>

            @if (TempData["RegisterSuccessMessage"] is string successMessage)
            {
                <div class="alert alert-success" role="status">@successMessage</div>
            }
            @if (ViewBag.Status != null)
            {
                <div class="alert alert-danger" role="alert">@ViewBag.Status</div>
            }

            <form asp-controller="Home" asp-action="Login" method="post">
                <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
                <div class="mb-3">
                    <label class="form-label" for="login-email">อีเมล</label>
                    <input id="login-email" type="email" name="Email" class="form-control" autocomplete="username" required />
                </div>
                <div class="mb-4">
                    <label class="form-label" for="login-password">รหัสผ่าน</label>
                    <input id="login-password" type="password" name="Password" class="form-control" autocomplete="current-password" required />
                </div>
                <button type="submit" class="btn btn-primary w-100">เข้าสู่ระบบ</button>
            </form>

            <p class="text-muted small text-center mt-3 mb-0">
                ยังไม่มีบัญชี? <a asp-controller="Home" asp-action="Register" asp-route-returnUrl="@ViewBag.ReturnUrl">สมัครสมาชิก</a>
            </p>
        </div>
    </div>
</section>
