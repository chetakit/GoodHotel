@model GoodHotel.Models.ViewModels.MyBookingViewModel

@{
    var culture = System.Globalization.CultureInfo.InvariantCulture;
    var booking = Model;
}

<article class="room-card">
    <div class="row g-0">
        <div class="col-md-4 col-lg-3">
            <img class="room-image w-100 h-100"
                 src="@booking.ImagePath"
                 alt="@booking.RoomType หมายเลข @booking.RoomNumber"
                 onerror="this.onerror=null;this.src='@Url.Content("~/images/default-room.svg")';" />
        </div>
        <div class="col-md-8 col-lg-9">
            <div class="room-body h-100 d-flex flex-column">
                <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-3">
                    <div>
                        <h3 class="h4 mt-2 mb-1">@(booking.RoomType ?? "ห้องพัก")</h3>
                        <span class="text-muted">การจอง <strong class="text-body">#@booking.BookingId</strong> · @(booking.RoomNumber == null ? "ไม่ระบุ" : $"ห้อง {booking.RoomNumber}")</span>
                    </div>
                    <span class="badge rounded-pill fs-6 @booking.StayBadgeClass">@booking.StayLabel</span>
                </div>

                <div class="row g-3">
                    <div class="col-6 col-lg-3">
                        <small class="text-muted d-block">วันเข้าพัก</small>
                        <strong>@ThaiText.Date(booking.CheckIn)</strong>
                    </div>
                    <div class="col-6 col-lg-3">
                        <small class="text-muted d-block">วันออก</small>
                        <strong>@ThaiText.Date(booking.CheckOut)</strong>
                    </div>
                    <div class="col-6 col-lg-3">
                        <small class="text-muted d-block">จำนวนผู้เข้าพัก</small>
                        <strong>@(booking.Guests?.ToString() ?? "ไม่ระบุ")</strong>
                    </div>
                    <div class="col-6 col-lg-3">
                        <small class="text-muted d-block">จำนวนคืน</small>
                        <strong>@(booking.NightCount?.ToString() ?? "ไม่ระบุ")</strong>
                    </div>
                </div>

                <div class="mt-auto pt-3">
                    <div class="room-price">
                        <span>@(booking.Amount.HasValue ? "฿" + booking.Amount.Value.ToString("N2", culture) : "ไม่ระบุยอดรวม")</span>
                        <small>ยอดรวม</small>
                    </div>
                    <p class="mt-2 mb-1">การชำระเงิน: @ThaiText.Status(booking.PaymentStatus)@(booking.BookingStatus == GoodHotel.Models.BookingStatuses.Cancelled && booking.PaymentStatus == "Paid" ? " (ไม่คืนเงิน)" : "")</p>
                    <partial name="_PaymentDeadline" model="booking.PaymentDueAtUtc" />
                    @if (booking.IsMockPayment)
                    {
                        <p>การชำระเงินจำลอง ไม่มีการโอนเงินจริง</p>
                    }
                    @if (booking.BookingStatus != GoodHotel.Models.BookingStatuses.Cancelled)
                    {
                        <p>ยอดคงค้าง: @(booking.OutstandingAmount.HasValue ? $"฿{booking.OutstandingAmount:N2}" : "ต้องตรวจสอบ")</p>
                    }
                    @if (booking.RoomMoved != null)
                    {
                        <p class="text-primary-emphasis mb-2">โรงแรมย้ายห้องให้: @booking.RoomMoved · ไม่มีค่าใช้จ่ายเพิ่ม</p>
                    }
                    @switch (booking.RefundStatus)
                    {
                        case "Requested":
                            <p class="text-warning-emphasis mb-2">คำขอคืนเงิน: รอฝ่ายบัญชีพิจารณา (การจองยังอยู่ตามเดิม)</p>
                            break;
                        case "Rejected":
                            <p class="text-danger mb-2">คำขอคืนเงินถูกปฏิเสธ · ดูเหตุผลที่หน้าการชำระเงิน@(booking.CanCancel ? " · ยังมาพักได้ตามปกติ หรือยกเลิกเองแบบไม่คืนเงิน" : "")</p>
                            break;
                        case "Approved":
                            <p class="text-success mb-2">อนุมัติคืนเงินแล้ว การจองถูกยกเลิกให้อัตโนมัติ</p>
                            break;
                        case "Closed":
                            <p class="text-muted mb-2">คำขอคืนเงินถูกปิด เพราะเช็คอินเข้าพักแล้ว</p>
                            break;
                    }

                    <div class="d-flex flex-wrap gap-2">
                        <a asp-controller="Payment" asp-action="Details" asp-route-id="@booking.BookingId"
                           class="btn btn-outline-primary">ดูการชำระเงิน</a>
                        @if (booking.PaymentStatus is "Paid" or "Refunded")
                        {
                            <a asp-controller="Payment" asp-action="Receipt" asp-route-id="@booking.BookingId"
                               class="btn btn-outline-primary">ใบเสร็จ</a>
                        }

                        @if (booking.CanRequestRefund)
                        {
                            <a asp-controller="Payment" asp-action="Details" asp-route-id="@booking.BookingId"
                               asp-fragment="refund" class="btn btn-outline-primary">ขอคืนเงิน</a>
                        }
                        @if (booking.CanCancel)
                        {
                            @* จ่ายแล้วยกเลิกเองได้แต่ไม่คืนเงิน: เตือนให้ชัดก่อนกด *@
                            var paidAlready = booking.PaymentStatus == "Paid";
                            <form asp-controller="Home" asp-action="CancelBooking" method="post"
                                  onsubmit="return confirm('@(paidAlready
                                      ? $"การจอง #{booking.BookingId} ชำระเงินแล้ว ยกเลิกเองจะไม่ได้รับเงินคืน{(booking.CanRequestRefund ? " (ถ้าต้องการเงินคืน ให้กดขอคืนเงินแทน)" : "")} ยืนยันยกเลิก?"
                                      : $"ยืนยันยกเลิกการจอง #{booking.BookingId} ?")');">
                                <input type="hidden" name="bookingId" value="@booking.BookingId" />
                                <button type="submit" class="btn btn-outline-danger">@(paidAlready ? "ยกเลิก (ไม่คืนเงิน)" : "ยกเลิกการจอง")</button>
                            </form>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</article>
