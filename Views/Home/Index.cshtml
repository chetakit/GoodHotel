@model GoodHotel.Models.ViewModels.HomeViewModel

@{
    ViewData["Title"] = "หน้าแรก";
    var today = GoodHotel.Services.RoomAvailabilityService.HotelDate(DateTime.UtcNow).ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture);
    var lowestRate = Model.FeaturedRooms.Where(r => r.Rate.HasValue).Select(r => r.Rate!.Value).DefaultIfEmpty().Min();
}

<section class="home-hero">
    <div class="container">
        <div class="row g-4 g-lg-5 align-items-center">
            <div class="col-lg-6">
                <h1>ห้องพักเงียบสงบ<br />กลางสุขุมวิท</h1>
                <p class="lead">
                    @Model.FeaturedRooms.Count ห้องพร้อมให้จอง
                    @if (lowestRate > 0)
                    {
                        <span>· เริ่มต้น ฿@lowestRate.ToString("N0") ต่อคืน</span>
                    }
                </p>

                <form asp-controller="Home" asp-action="Rooms" method="get" class="stay-search">
                    <div>
                        <label class="form-label" for="hero-checkin">วันเข้าพัก</label>
                        <input id="hero-checkin" type="date" name="CheckIn" min="@today" class="form-control" required />
                    </div>
                    <div>
                        <label class="form-label" for="hero-checkout">วันออก</label>
                        <input id="hero-checkout" type="date" name="CheckOut" min="@today" class="form-control" required />
                    </div>
                    <div>
                        <label class="form-label" for="hero-guests">ผู้เข้าพัก</label>
                        <input id="hero-guests" type="number" name="Guests" min="1" value="1" class="form-control" required />
                    </div>
                    <button type="submit" class="btn btn-primary">ค้นหาห้องว่าง</button>
                </form>
            </div>
            <div class="col-lg-6">
                <img class="home-hero-photo" src="~/images/bangkok-skyline.jpg" alt="ตึกสูงใจกลางกรุงเทพฯ ยามเย็น" />
            </div>
        </div>
    </div>
</section>

<section class="content-section pt-2">
    <div class="container">
        <div class="section-heading d-flex justify-content-between align-items-end gap-3">
            <h2 class="mb-0">ห้องพัก</h2>
            <a asp-controller="Home" asp-action="Rooms">ดูทั้งหมดและเช็ควันว่าง</a>
        </div>

        @if (!Model.FeaturedRooms.Any())
        {
            <div class="feature-box">
                <h4>ยังไม่มีห้องพักที่พร้อมให้จอง</h4>
                <p class="text-muted mb-0">กรุณากลับมาตรวจสอบอีกครั้ง</p>
            </div>
        }
        else
        {
            <div class="row g-4">
                @foreach (var room in Model.FeaturedRooms)
                {
                    <div class="col-lg-4 col-md-6">
                        <article class="room-card h-100">
                            <img class="room-image" src="@room.ImagePath" alt="@room.Type หมายเลข @room.RoomNumber" loading="lazy"
                                 onerror="this.onerror=null;this.src='@Url.Content("~/images/default-room.svg")';" />
                            <div class="room-body">
                                <div class="room-meta">
                                    <div>
                                        <h4>@ThaiText.OrDash(room.Type)</h4>
                                        <span class="text-muted small">ห้อง @room.RoomNumber</span>
                                    </div>
                                    <div class="room-price">
                                        @(room.Rate.HasValue ? $"฿{room.Rate.Value:N0}" : "-")
                                        <small>/คืน</small>
                                    </div>
                                </div>
                                @if (room.Capacity.HasValue)
                                {
                                    <div class="room-features"><span>พักได้ @room.Capacity.Value คน</span></div>
                                }
                                <a asp-action="RoomDetails" asp-route-id="@room.RoomId" class="btn btn-outline-primary w-100">ดูรายละเอียดและวันว่าง</a>
                            </div>
                        </article>
                    </div>
                }
            </div>
        }
    </div>
</section>

@if (Model.Promotions.Any())
{
    <section class="content-section bg-light">
        <div class="container">
            <div class="section-heading">
                <h2>โปรโมชัน</h2>
                <p>ระบบเลือกส่วนลดที่คุ้มที่สุดให้อัตโนมัติตอนจอง ไม่ต้องกรอกโค้ด</p>
            </div>
            <div class="row g-4">
                @foreach (var promotion in Model.Promotions.Take(6))
                {
                    <div class="col-lg-4 col-md-6">
                        <partial name="_PromotionCard" model="promotion" />
                    </div>
                }
            </div>
        </div>
    </section>
}
