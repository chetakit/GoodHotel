@model GoodHotel.Models.User

@{
    ViewData["Title"] = "สมัครสมาชิก";
}

<section class="content-section">
    <div class="container">
        <div class="auth-card auth-card-wide">
            <ul class="nav nav-pills nav-fill mb-4">
                <li class="nav-item">
                    <a class="nav-link" asp-controller="Home" asp-action="Login" asp-route-returnUrl="@ViewBag.ReturnUrl">เข้าสู่ระบบ</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link active" asp-controller="Home" asp-action="Register">สมัครสมาชิก</a>
                </li>
            </ul>

            <h2 class="h4 mb-1">สมัครสมาชิก</h2>
            @if (ViewBag.Status != null)
            {
                <div class="alert alert-warning" role="alert">@ViewBag.Status</div>
            }
            <p class="text-muted small mb-3">ใช้อีเมลนี้เข้าสู่ระบบเพื่อจอง ชำระเงิน และดูการจองของคุณ</p>

            <form asp-controller="Home" asp-action="Register" method="post">
                <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
                <div asp-validation-summary="All" class="text-danger mb-3"></div>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="FirstName" class="form-label">ชื่อ</label>
                        <input asp-for="FirstName" class="form-control" placeholder="สมชาย" />
                        <span asp-validation-for="FirstName" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="LastName" class="form-label">นามสกุล</label>
                        <input asp-for="LastName" class="form-control" placeholder="ใจดี" />
                        <span asp-validation-for="LastName" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Email" class="form-label">อีเมล</label>
                        <input asp-for="Email" type="email" class="form-control" placeholder="your@email.com" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Phone" class="form-label">เบอร์โทร</label>
                        <input asp-for="Phone" type="tel" class="form-control" inputmode="numeric"
                               autocomplete="tel" placeholder="081 234 5678" maxlength="12" />
                        <div class="form-text">กรอกหมายเลขโทรศัพท์มือถือไทย 10 หลัก</div>
                        <span asp-validation-for="Phone" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="BirthDate" class="form-label">วันเกิด</label>
                        <input asp-for="BirthDate" type="date" class="form-control" />
                        <span asp-validation-for="BirthDate" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Password" class="form-label">รหัสผ่าน</label>
                        <input asp-for="Password" type="password" class="form-control" placeholder="8 ตัวอักษรขึ้นไป" minlength="8" autocomplete="new-password" />
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label for="ConfirmPassword" class="form-label">ยืนยันรหัสผ่าน</label>
                        <input type="password" id="ConfirmPassword" name="ConfirmPassword"
                               class="form-control" placeholder="กรอกรหัสผ่านอีกครั้ง" />
                        @if (ViewData.ModelState.TryGetValue("ConfirmPassword", out var confirmPasswordState)
                            && confirmPasswordState.Errors.Count > 0)
                        {
                            <span class="text-danger">@confirmPasswordState.Errors[0].ErrorMessage</span>
                        }
                    </div>

                    <div class="col-12">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="AgreeToTerms"
                                   value="true" id="agreeCheck" checked="@(ViewBag.AgreeToTerms == true)" />
                            <label class="form-check-label" for="agreeCheck">
                                ยอมรับข้อกำหนดและนโยบายความเป็นส่วนตัว
                            </label>
                        </div>
                        @if (ViewData.ModelState.TryGetValue("AgreeToTerms", out var termsState)
                            && termsState.Errors.Count > 0)
                        {
                            <span class="text-danger">@termsState.Errors[0].ErrorMessage</span>
                        }
                    </div>

                    <div class="col-12">
                        <button type="submit" class="btn btn-primary hotel-primary-btn w-100">
                            สมัครสมาชิก
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
    const phoneInput = document.getElementById("@Html.IdFor(model => model.Phone)");

    if (phoneInput) {
        phoneInput.addEventListener("input", () => {
            const digits = phoneInput.value.replace(/\D/g, "").slice(0, 10);

            phoneInput.value = digits.length > 6
                ? `${digits.slice(0, 3)} ${digits.slice(3, 6)} ${digits.slice(6)}`
                : digits.length > 3
                    ? `${digits.slice(0, 3)} ${digits.slice(3)}`
                    : digits;
        });
    }
</script>
}
