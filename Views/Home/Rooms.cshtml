@model GoodHotel.Models.ViewModels.AvailabilitySearchViewModel

@{
    ViewData["Title"] = "Rooms";
    var culture = System.Globalization.CultureInfo.InvariantCulture;
}

<section class="content-section">
    <div class="container">
        <div class="section-heading">
            <span class="eyebrow text-dark">Rooms &amp; Suites</span>
            <h2>ค้นหาห้องพักที่เหมาะสม</h2>
            <p>เลือกห้องพักที่ใช่ แล้วตรวจสอบวันว่างจากปฏิทินการจองจริง</p>
        </div>

        @if (Model.HasSearchCriteria && !ViewData.ModelState.IsValid)
        {
            <div class="feature-box mb-4">
                <h4>กรุณาตรวจสอบข้อมูลการค้นหาจากหน้า Home</h4>
                <div asp-validation-summary="All" class="text-danger"></div>
            </div>
        }
        else if (Model.HasSearched)
        {
            <div class="mb-4 text-muted">
                ห้องว่างสำหรับ @Model.CheckIn?.ToString("dd MMM yyyy", culture)
                ถึง @Model.CheckOut?.ToString("dd MMM yyyy", culture)
                (@Model.Guests guest@(Model.Guests == 1 ? "" : "s"))
            </div>
        }

        <div class="row g-4">
            @if (!Model.Rooms.Any())
            {
                <div class="col-12">
                    <div class="feature-box text-center">
                        @if (Model.HasSearched)
                        {
                            <h4>ไม่พบห้องว่างในช่วงวันที่เลือก</h4>
                            <p class="text-muted mb-0">ลองเลือกวันที่อื่นหรือปรับจำนวนผู้เข้าพัก</p>
                        }
                        else
                        {
                            <h4>ยังไม่มีห้องพัก</h4>
                            <p class="text-muted mb-0">ขณะนี้ยังไม่มีข้อมูลห้องพักให้แสดง</p>
                        }
                    </div>
                </div>
            }
            else
            {
                @foreach (var room in Model.Rooms)
                {
                    <div class="col-lg-4 col-md-6">
                        <article class="room-card h-100">
                            <img class="room-image w-100"
                                 src="@room.ImagePath"
                                 alt="@room.Type room @room.RoomNumber"
                                 onerror="this.onerror=null;this.src='@Url.Content("~/images/default-room.svg")';" />
                            <div class="room-body">
                                <div class="room-meta">
                                    <div>
                                        <h4 class="mb-1">@room.Type</h4>
                                        <span class="text-muted">Room @room.RoomNumber</span>
                                    </div>
                                    <span class="badge-status @(room.Status == "Available" ? "available" : "booked")">
                                        @room.Status
                                    </span>
                                </div>
                                <div class="room-price">
                                    @(room.Rate.HasValue ? $"฿{room.Rate.Value.ToString("N2", culture)}" : "ราคาไม่ระบุ")
                                    <small>/night</small>
                                </div>
                                @if (!string.IsNullOrWhiteSpace(room.Description))
                                {
                                    <p class="text-muted">@room.Description</p>
                                }
                                <div class="room-features">
                                    @if (room.Capacity.HasValue)
                                    {
                                        <span>@room.Capacity.Value Guests</span>
                                    }
                                    else
                                    {
                                        <span>ไม่ระบุจำนวนผู้เข้าพัก</span>
                                    }
                                </div>
                                @if (room.Status == "Available")
                                {
                                    <button type="button"
                                            class="btn btn-primary hotel-primary-btn w-100 js-open-room-calendar"
                                            data-room-id="@room.RoomId"
                                            data-room-number="@room.RoomNumber"
                                            data-room-type="@room.Type"
                                            data-room-rate="@(room.Rate?.ToString(culture) ?? "")"
                                            data-room-capacity="@(room.Capacity?.ToString(culture) ?? "")">
                                        เลือกวันเข้าพักเพื่อจอง
                                    </button>
                                }
                                else
                                {
                                    <button type="button" class="btn btn-outline-secondary w-100" disabled>
                                        ไม่พร้อมให้จอง
                                    </button>
                                }
                            </div>
                        </article>
                    </div>
                }
            }
        </div>
    </div>
</section>

<div id="room-calendar-modal"
     class="calendar-modal"
     data-availability-url="@Url.Action("RoomAvailability", "Home")"
     data-booking-url="@Url.Action("Booking", "Home")"
     data-today="@DateOnly.FromDateTime(DateTime.Today).ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture)"
     role="dialog"
     aria-modal="true"
     aria-labelledby="calendar-title"
     aria-hidden="true"
     hidden>
    <div class="calendar-dialog">
        <button type="button"
                class="calendar-close"
                data-calendar-close
                aria-label="ปิดปฏิทิน">
            &times;
        </button>
        <div class="calendar-heading">
            <span class="eyebrow text-dark">Your Stay</span>
            <h2 id="calendar-title">เลือกวันเข้าพัก</h2>
            <p id="calendar-room-details" class="text-muted mb-0"></p>
        </div>

        <div class="calendar-month-navigation">
            <button type="button"
                    id="calendar-previous-month"
                    class="calendar-month-button"
                    aria-label="เดือนก่อนหน้า">
                &lsaquo;
            </button>
            <h3 id="calendar-month-label" class="h5 mb-0"></h3>
            <button type="button"
                    id="calendar-next-month"
                    class="calendar-month-button"
                    aria-label="เดือนถัดไป">
                &rsaquo;
            </button>
        </div>

        <div class="calendar-weekdays" aria-hidden="true">
            <span>อา.</span><span>จ.</span><span>อ.</span><span>พ.</span>
            <span>พฤ.</span><span>ศ.</span><span>ส.</span>
        </div>
        <div id="calendar-days" class="calendar-days" aria-live="polite"></div>
        <div class="calendar-legend">
            <span><i class="legend-dot available"></i>ว่าง</span>
            <span><i class="legend-dot occupied"></i>มีการจอง</span>
            <span><i class="legend-dot selected"></i>วันที่เลือก</span>
        </div>

        <div id="calendar-error" class="alert alert-danger py-2 mt-3" role="alert" hidden></div>
        <div id="calendar-selection-prompt" class="calendar-prompt" aria-live="polite">
            เลือกวันที่เข้าพักเพื่อเริ่มต้น
        </div>

        <div class="calendar-booking-controls">
            <div>
                <label for="calendar-guests" class="form-label">จำนวนผู้เข้าพัก</label>
                <input id="calendar-guests"
                       class="form-control"
                       type="number"
                       min="1"
                       step="1"
                       value="1"
                       required />
            </div>
            <div class="calendar-estimate">
                <small>จำนวนคืน</small>
                <strong id="calendar-night-count">-</strong>
            </div>
            <div class="calendar-estimate">
                <small>ยอดประมาณการ</small>
                <strong id="calendar-total">-</strong>
            </div>
        </div>

        <div class="calendar-actions">
            <button type="button"
                    class="btn btn-outline-primary hotel-secondary-btn"
                    data-calendar-close>
                ยกเลิก
            </button>
            <button type="button"
                    id="calendar-continue"
                    class="btn btn-primary hotel-primary-btn"
                    disabled>
                ดำเนินการจอง
            </button>
        </div>
    </div>
</div>
