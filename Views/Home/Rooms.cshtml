@model GoodHotel.Models.ViewModels.AvailabilitySearchViewModel

@{
    ViewData["Title"] = "ห้องพัก";
    var culture = System.Globalization.CultureInfo.InvariantCulture;
}

<section class="content-section">
    <div class="container">
        <div class="section-heading">
            <h2>ค้นหาห้องพักที่เหมาะสม</h2>
            <p>เลือกห้องพักที่ใช่ แล้วตรวจสอบวันว่างจากปฏิทินการจองจริง</p>
        </div>

        @if (TempData["BookingSuccess"] is string cancelled)
        {
            <div class="alert alert-success" role="status">@cancelled เลือกห้องใหม่สำหรับวันเดิมได้จากรายการด้านล่าง</div>
        }

        @if (Model.HasSearchCriteria && !ViewData.ModelState.IsValid)
        {
            <div class="feature-box mb-4">
                <h4>กรุณาเลือกวันที่เข้าพักจากหน้าแรก</h4>
                <div asp-validation-summary="All" class="text-danger"></div>
            </div>
        }
        else if (Model.HasSearched)
        {
            <div class="mb-4 text-muted">
                ห้องว่างสำหรับวันที่ @ThaiText.Date(Model.CheckIn)
                ถึง @ThaiText.Date(Model.CheckOut)
                (ผู้เข้าพัก @Model.Guests คน)
            </div>
        }

        <div class="row g-4">
            @if (!Model.Rooms.Any())
            {
                <div class="col-12">
                    <div class="feature-box text-center">
                        @if (Model.HasSearched)
                        {
                            <h4>ไม่พบห้องว่างในช่วงวันที่เลือก</h4>
                            <p class="text-muted mb-0">ลองเลือกวันที่อื่นหรือปรับจำนวนผู้เข้าพัก</p>
                        }
                        else
                        {
                            <h4>ยังไม่มีห้องพัก</h4>
                            <p class="text-muted mb-0">ขณะนี้ยังไม่มีข้อมูลห้องพักให้แสดง</p>
                        }
                    </div>
                </div>
            }
            else
            {
                @foreach (var room in Model.Rooms)
                {
                    <div class="col-lg-4 col-md-6">
                        <article class="room-card h-100">
                            <a asp-action="RoomDetails" asp-route-id="@room.RoomId"
                               asp-route-checkIn="@(Model.HasSearched ? Model.CheckIn?.ToString("yyyy-MM-dd", culture) : null)"
                               asp-route-checkOut="@(Model.HasSearched ? Model.CheckOut?.ToString("yyyy-MM-dd", culture) : null)"
                               asp-route-guests="@(Model.HasSearched ? Model.Guests : null)">
                            <img class="room-image w-100"
                                 src="@room.ImagePath"
                                 alt="@room.Type หมายเลข @room.RoomNumber"
                                 onerror="this.onerror=null;this.src='@Url.Content("~/images/default-room.svg")';" />
                            </a>
                            <div class="room-body">
                                <div class="room-meta">
                                    <div>
                                        <h4 class="mb-1">@room.Type</h4>
                                        <span class="text-muted">ห้อง @room.RoomNumber</span>
                                    </div>
                                    <span class="badge-status @(room.Status == "Available" ? "available" : "booked")">
                                        @* ยังไม่ค้นวันที่ = ยังไม่รู้ว่าว่างวันไหน บอกได้แค่ว่าเปิดให้จอง *@
                                        @(room.Status == "Available" ? (Model.HasSearched ? "ว่าง" : "เปิดให้จอง") : "ไม่พร้อมให้จอง")
                                    </span>
                                </div>
                                <div class="room-price">
                                    @(room.Rate.HasValue ? $"฿{room.Rate.Value.ToString("N2", culture)}" : "ราคาไม่ระบุ")
                                    <small>/คืน</small>
                                </div>
                                @if (!string.IsNullOrWhiteSpace(room.Description))
                                {
                                    <p class="text-muted">@room.Description</p>
                                }
                                <div class="room-features">
                                    @if (room.Capacity.HasValue)
                                    {
                                        <span>รับได้ @room.Capacity.Value คน</span>
                                    }
                                    else
                                    {
                                        <span>ไม่ระบุจำนวนผู้เข้าพัก</span>
                                    }
                                </div>
                                <a class="btn btn-outline-primary w-100" asp-action="RoomDetails" asp-route-id="@room.RoomId"
                               asp-route-checkIn="@(Model.HasSearched ? Model.CheckIn?.ToString("yyyy-MM-dd", culture) : null)"
                               asp-route-checkOut="@(Model.HasSearched ? Model.CheckOut?.ToString("yyyy-MM-dd", culture) : null)"
                               asp-route-guests="@(Model.HasSearched ? Model.Guests : null)">ดูรายละเอียด</a>
                                @if (room.Status == "Available" && Model.HasSearched && ViewData.ModelState.IsValid)
                                {
                                    @* ค้นหาด้วยวันที่มาแล้ว: ไปหน้ายืนยันการจองได้เลย ไม่ต้องเลือกวันซ้ำ *@
                                    <a class="btn btn-primary hotel-primary-btn w-100"
                                       asp-action="Booking"
                                       asp-route-roomId="@room.RoomId"
                                       asp-route-checkIn="@Model.CheckIn?.ToString("yyyy-MM-dd", culture)"
                                       asp-route-checkOut="@Model.CheckOut?.ToString("yyyy-MM-dd", culture)"
                                       asp-route-guests="@Model.Guests">
                                        จองห้องนี้
                                    </a>
                                    <button type="button"
                                            class="btn btn-link w-100 mt-1 js-open-room-calendar"
                                            data-room-id="@room.RoomId"
                                            data-room-number="@room.RoomNumber"
                                            data-room-type="@room.Type"
                                            data-room-rate="@(room.Rate?.ToString(culture) ?? "")"
                                            data-room-capacity="@(room.Capacity?.ToString(culture) ?? "")">
                                        เปลี่ยนวันที่
                                    </button>
                                }
                                else if (room.Status == "Available")
                                {
                                    <button type="button"
                                            class="btn btn-primary hotel-primary-btn w-100 js-open-room-calendar"
                                            data-room-id="@room.RoomId"
                                            data-room-number="@room.RoomNumber"
                                            data-room-type="@room.Type"
                                            data-room-rate="@(room.Rate?.ToString(culture) ?? "")"
                                            data-room-capacity="@(room.Capacity?.ToString(culture) ?? "")">
                                        เลือกวันเข้าพักเพื่อจอง
                                    </button>
                                }
                                else
                                {
                                    <button type="button" class="btn btn-outline-secondary w-100" disabled>
                                        ไม่พร้อมให้จอง
                                    </button>
                                }
                            </div>
                        </article>
                    </div>
                }
            }
        </div>
    </div>
</section>

<partial name="_RoomCalendar" />
