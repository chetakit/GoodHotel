@model GoodHotel.Models.ViewModels.HousekeepingTasksViewModel
@{
    ViewData["Title"] = "Cleaning Tasks";
}
<section class="content-section">
    <div class="container">
        <div class="section-heading"><span class="eyebrow text-dark">Hotel Operations</span><h2>Cleaning Tasks</h2></div>
        @if (TempData["TaskSuccess"] is string success) { <div class="alert alert-success" role="status">@success</div> }
        @if (TempData["TaskError"] is string error) { <div class="alert alert-warning" role="alert">@error</div> }
        <h3>My active tasks</h3>
        @if (Model.Assigned.Count == 0) { <p>No active tasks assigned to you.</p> }
        else
        {
            <ul>
                @foreach (var task in Model.Assigned)
                {
                    <li><a asp-action="TaskDetails" asp-route-id="@task.TaskId">Task #@task.TaskId</a> — Room @(task.RoomNumber ?? "Not specified") — @task.TaskType — @task.Status</li>
                }
            </ul>
        }
        <h3>Available tasks</h3>
        @if (Model.Available.Count == 0) { <p>No tasks are available to claim.</p> }
        else
        {
            <ul>
                @foreach (var task in Model.Available)
                {
                    <li><a asp-action="TaskDetails" asp-route-id="@task.TaskId">Task #@task.TaskId</a> — Room @(task.RoomNumber ?? "Not specified") — @task.TaskType</li>
                }
            </ul>
        }
    </div>
</section>
