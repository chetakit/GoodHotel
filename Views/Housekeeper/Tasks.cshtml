@* งานที่รับได้และงานของฉัน *@
@model GoodHotel.Models.ViewModels.HousekeepingTasksViewModel
@{
    ViewData["Title"] = "งานทำความสะอาด";
}

@if (TempData["TaskSuccess"] is string success) { <div class="alert alert-success" role="status">@success</div> }
@if (TempData["TaskError"] is string error) { <div class="alert alert-warning" role="alert">@error</div> }

<section class="table-panel mb-3">
    <div class="panel-head">
        <h2>งานของฉันที่ยังไม่เสร็จ</h2>
        <span class="text-muted small">@Model.Assigned.Count งาน</span>
    </div>
    @if (Model.Assigned.Count == 0)
    {
        <p class="panel-empty">ไม่มีงานค้าง รับงานใหม่ได้จากรายการด้านล่าง</p>
    }
    else
    {
        @foreach (var task in Model.Assigned)
        {
            <div class="task-row">
                <a class="task-room" asp-action="TaskDetails" asp-route-id="@task.TaskId">ห้อง @ThaiText.OrDash(task.RoomNumber)</a>
                <div class="task-meta">
                    @ThaiText.Status(task.TaskType) · งาน #@task.TaskId
                    <span class="badge @ThaiText.Badge(task.Status) ms-1">@ThaiText.Status(task.Status)</span>
                    @if (task.ReworkReason != null) { <div class="text-danger">ตรวจไม่ผ่าน ต้องแก้: @task.ReworkReason</div> }
                </div>
                <div class="task-action">
                    @if (task.Status == "Accepted")
                    {
                        <form asp-action="Start" asp-route-id="@task.TaskId" method="post"><button class="btn btn-primary" type="submit">เริ่มทำ</button></form>
                    }
                    else if (task.Status == "InProgress")
                    {
                        <form asp-action="Complete" asp-route-id="@task.TaskId" method="post"><button class="btn btn-success" type="submit">ทำเสร็จแล้ว</button></form>
                    }
                </div>
            </div>
        }
    }
</section>

<section class="table-panel">
    <div class="panel-head">
        <h2>งานที่รอคนรับ</h2>
        <span class="text-muted small">@Model.Available.Count งาน</span>
    </div>
    @if (Model.Available.Count == 0)
    {
        <p class="panel-empty">ไม่มีงานที่รอคนรับ งานจะเข้ามาเองเมื่อพนักงานต้อนรับเช็คเอาท์ลูกค้า</p>
    }
    else
    {
        @foreach (var task in Model.Available)
        {
            <div class="task-row">
                <a class="task-room" asp-action="TaskDetails" asp-route-id="@task.TaskId">ห้อง @ThaiText.OrDash(task.RoomNumber)</a>
                <div class="task-meta">@ThaiText.Status(task.TaskType) · งาน #@task.TaskId@if (task.ReworkReason != null) { <div class="text-danger">ตรวจไม่ผ่าน ต้องแก้: @task.ReworkReason</div> }</div>
                <div class="task-action">
                    <form asp-action="ClaimAndStart" asp-route-id="@task.TaskId" method="post"><button class="btn btn-primary" type="submit">รับงานและเริ่มทำ</button></form>
                </div>
            </div>
        }
    }
</section>
