@model GoodHotel.Models.ViewModels.HousekeepingTasksViewModel
@{
    ViewData["Title"] = "งานทำความสะอาด";
}
<section class="content-section">
    <div class="container">
        <div class="section-heading"><span class="eyebrow text-dark">Housekeeping</span><h2>งานทำความสะอาด</h2></div>
        <p class="text-muted">งานจะเด้งเข้ามาเองเมื่อพนักงานต้อนรับเช็คเอาท์ลูกค้า กด "รับงานและเริ่มทำ" → ทำความสะอาด → กด "ทำเสร็จแล้ว"</p>
        @if (TempData["TaskSuccess"] is string success) { <div class="alert alert-success" role="status">@success</div> }
        @if (TempData["TaskError"] is string error) { <div class="alert alert-warning" role="alert">@error</div> }

        <h3>งานของฉันที่ยังไม่เสร็จ</h3>
        @if (Model.Assigned.Count == 0)
        {
            <p>ไม่มีงานค้าง</p>
        }
        else
        {
            <ul>
                @foreach (var task in Model.Assigned)
                {
                    <li class="mb-2">
                        <a asp-action="TaskDetails" asp-route-id="@task.TaskId">งาน #@task.TaskId</a> — @ThaiText.OrDash(task.RoomNumber) — @ThaiText.Status(task.TaskType) — @ThaiText.Status(task.Status)
                        @if (task.Status == "Accepted")
                        {
                            <form asp-action="Start" asp-route-id="@task.TaskId" method="post" class="d-inline ms-2"><button class="btn btn-sm btn-primary" type="submit">เริ่มทำ</button></form>
                        }
                        else if (task.Status == "InProgress")
                        {
                            <form asp-action="Complete" asp-route-id="@task.TaskId" method="post" class="d-inline ms-2"><button class="btn btn-sm btn-success" type="submit">ทำเสร็จแล้ว</button></form>
                        }
                    </li>
                }
            </ul>
        }

        <h3>งานที่รอคนรับ</h3>
        @if (Model.Available.Count == 0)
        {
            <p>ไม่มีงานที่รอคนรับ</p>
        }
        else
        {
            <ul>
                @foreach (var task in Model.Available)
                {
                    <li class="mb-2">
                        <a asp-action="TaskDetails" asp-route-id="@task.TaskId">งาน #@task.TaskId</a> — @ThaiText.OrDash(task.RoomNumber) — @ThaiText.Status(task.TaskType)
                        <form asp-action="ClaimAndStart" asp-route-id="@task.TaskId" method="post" class="d-inline ms-2"><button class="btn btn-sm btn-primary" type="submit">รับงานและเริ่มทำ</button></form>
                    </li>
                }
            </ul>
        }
    </div>
</section>
