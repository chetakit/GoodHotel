@* หน้าหลักแม่บ้าน *@
@model GoodHotel.Models.ViewModels.HousekeepingDashboardViewModel
@{
    ViewData["Title"] = "หน้าหลัก";
}

@section Actions {
    <a asp-action="Tasks" class="btn btn-primary btn-sm">ไปที่งานทำความสะอาด</a>
}

<div class="figures">
    <div class="figure @(Model.AvailableCount > 0 ? "is-alert" : "")">
        <a asp-action="Tasks">
            <div class="label">งานรอคนรับ</div>
            <div class="value">@Model.AvailableCount</div>
        </a>
    </div>
    <div class="figure">
        <div class="label">ฉันรับแล้ว ยังไม่เริ่ม</div>
        <div class="value">@Model.AcceptedCount</div>
    </div>
    <div class="figure">
        <div class="label">กำลังทำ</div>
        <div class="value">@Model.InProgressCount</div>
    </div>
    <div class="figure">
        <div class="label">ทำเสร็จวันนี้</div>
        <div class="value">@Model.CompletedTodayCount</div>
    </div>
</div>

<section class="table-panel">
    <div class="panel-head">
        <h2>งานล่าสุดของฉัน</h2>
        <a asp-action="History">ประวัติทั้งหมด</a>
    </div>
    @if (Model.RecentTasks.Count == 0)
    {
        <p class="panel-empty">ยังไม่มีงาน งานจะเข้ามาเองเมื่อพนักงานต้อนรับเช็คเอาท์ลูกค้า</p>
    }
    else
    {
        <table class="table table-hover">
            <thead><tr><th>งาน</th><th>ห้อง</th><th>สถานะ</th><th></th></tr></thead>
            <tbody>
                @foreach (var task in Model.RecentTasks)
                {
                    <tr>
                        <td>#@task.TaskId</td>
                        <td>@ThaiText.OrDash(task.RoomNumber)</td>
                        <td><span class="badge @ThaiText.Badge(task.Status)">@ThaiText.Status(task.Status)</span></td>
                        <td class="text-end"><a class="btn btn-sm btn-outline-primary" asp-action="TaskDetails" asp-route-id="@task.TaskId">เปิด</a></td>
                    </tr>
                }
            </tbody>
        </table>
    }
</section>
