@model GoodHotel.Models.ViewModels.HousekeepingDashboardViewModel
@{
    ViewData["Title"] = "แดชบอร์ดแม่บ้าน";
}
<section class="content-section">
    <div class="container">
        <div class="section-heading">
            <span class="eyebrow text-dark">Housekeeping</span>
            <h2>แดชบอร์ดแม่บ้าน</h2>
        </div>
        <div class="row g-3 mb-4">
            <div class="col-md-3"><div class="card p-3">งานที่รอคนรับ <strong>@Model.AvailableCount</strong></div></div>
            <div class="col-md-3"><div class="card p-3">งานที่ฉันรับแล้ว <strong>@Model.AcceptedCount</strong></div></div>
            <div class="col-md-3"><div class="card p-3">งานที่ฉันกำลังทำ <strong>@Model.InProgressCount</strong></div></div>
            <div class="col-md-3"><div class="card p-3">ทำเสร็จวันนี้ <strong>@Model.CompletedTodayCount</strong></div></div>
        </div>
        <h3>งานล่าสุดของฉัน</h3>
        @if (Model.RecentTasks.Count == 0)
        {
            <p>ยังไม่มีงาน</p>
        }
        else
        {
            <ul>
                @foreach (var task in Model.RecentTasks)
                {
                    <li><a asp-action="TaskDetails" asp-route-id="@task.TaskId">งาน #@task.TaskId</a> — @ThaiText.OrDash(task.RoomNumber) — @ThaiText.Status(task.Status)</li>
                }
            </ul>
        }
        <a asp-action="Tasks" class="btn btn-primary">ดูงานทำความสะอาด</a>
    </div>
</section>
