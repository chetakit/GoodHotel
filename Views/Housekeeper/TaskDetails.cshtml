@* รายละเอียดงานแม่บ้าน *@
@model GoodHotel.Models.ViewModels.HousekeepingDetailsViewModel
@{
    ViewData["Title"] = $"งาน #{Model.Task.TaskId} · ห้อง {Model.Task.RoomNumber}";
    var task = Model.Task;
}
<section class="content-section">
    <div class="container">
        <dl>
            <dt>ห้อง</dt><dd>@ThaiText.OrDash(task.RoomNumber)</dd>
            <dt>ประเภทห้อง</dt><dd>@ThaiText.OrDash(task.RoomType)</dd>
            <dt>ประเภทงาน</dt><dd>@ThaiText.Status(task.TaskType)</dd>
            <dt>สถานะ</dt><dd><span class="badge @ThaiText.Badge(task.Status)">@ThaiText.Status(task.Status)</span></dd>
            <dt>สร้างงานเมื่อ</dt><dd>@ThaiText.Time(task.CreatedAtUtc)</dd>
            <dt>รับงานเมื่อ</dt><dd>@ThaiText.Time(task.AcceptedAtUtc)</dd>
            <dt>เริ่มทำเมื่อ</dt><dd>@ThaiText.Time(task.StartedAtUtc)</dd>
            <dt>ทำเสร็จเมื่อ</dt><dd>@ThaiText.Time(task.CompletedAtUtc)</dd>
        </dl>
        @if (task.ReworkReason != null) { <div class="alert alert-warning">ตรวจไม่ผ่าน ต้องแก้: @task.ReworkReason</div> }
        @if (task.Status == "Pending" && task.AssignedToUserId == null)
        {
            <form asp-action="ClaimAndStart" asp-route-id="@task.TaskId" method="post"><button class="btn btn-primary" type="submit">รับงานและเริ่มทำ</button></form>
        }
        else if (Model.IsMine && task.Status == "Accepted")
        {
            <form asp-action="Start" asp-route-id="@task.TaskId" method="post"><button class="btn btn-primary" type="submit">เริ่มทำ</button></form>
        }
        else if (Model.IsMine && task.Status == "InProgress")
        {
            <form asp-action="Complete" asp-route-id="@task.TaskId" method="post"><button class="btn btn-primary" type="submit">ทำเสร็จแล้ว</button></form>
        }
        <a asp-action="Tasks" class="btn btn-outline-primary mt-3">กลับไปรายการงาน</a>
        <a asp-action="History" class="btn btn-outline-secondary mt-3">ประวัติงาน</a>
    </div>
</section>
