@model GoodHotel.Models.ViewModels.RoomFormViewModel

@{
    var isEdit = Model.RoomId.HasValue;
    ViewData["Title"] = isEdit ? "แก้ไขห้องพัก" : "เพิ่มห้องพัก";
}

<div class="booking-panel" style="max-width: 820px">

    <form asp-controller="Admin"
          asp-action="@(isEdit ? "EditRoom" : "AddRoom")"
          method="post"
          enctype="multipart/form-data">
        @if (isEdit)
        {
            <input asp-for="RoomId" type="hidden" />
            <input asp-for="OriginalStatus" type="hidden" />
            <input asp-for="OriginalPreMaintenanceStatus" type="hidden" />
            <input asp-for="OriginalMaintenanceEventId" type="hidden" />
        }

        <div asp-validation-summary="All" class="text-danger"></div>
        <div class="row">
            <div class="col-md-6">
                <div class="mb-3">
                    <label asp-for="RoomNumber" class="form-label">หมายเลขห้อง</label>
                    <input asp-for="RoomNumber" class="form-control" />
                    <span asp-validation-for="RoomNumber" class="text-danger"></span>
                </div>
            </div>
            <div class="col-md-6">
                <div class="mb-3">
                    <label asp-for="Type" class="form-label">ประเภทห้อง</label>
                    <input asp-for="Type" class="form-control" />
                    <span asp-validation-for="Type" class="text-danger"></span>
                </div>
            </div>
            <div class="col-md-6">
                <div class="mb-3">
                    <label asp-for="Rate" class="form-label">ราคาต่อคืน (บาท)</label>
                    <input asp-for="Rate" type="number" min="0.01" max="99999999.99" step="0.01" class="form-control" />
                    <span asp-validation-for="Rate" class="text-danger"></span>
                </div>
            </div>
            <div class="col-md-6">
                <div class="mb-3">
                    <label asp-for="Capacity" class="form-label">รับได้ (คน)</label>
                    <input asp-for="Capacity" type="number" min="1" class="form-control" />
                    <span asp-validation-for="Capacity" class="text-danger"></span>
                </div>
            </div>
            <div class="col-md-6">
                <div class="mb-3">
                    <label asp-for="Status" class="form-label">สถานะห้อง</label>
                    <select asp-for="Status" class="form-select">
                        <option value="Available">ว่าง (พร้อมขาย)</option>
                        <option value="Occupied">มีผู้เข้าพัก</option>
                        <option value="Reserved">จองไว้ (ไม่พร้อมขาย)</option>
                        <option value="Maintenance">ซ่อมบำรุง</option>
                    </select>
                    <span asp-validation-for="Status" class="text-danger"></span>
                </div>
            </div>
            @if (Model.RequiresMaintenanceReview)
            {
                <div class="col-12">
                    <div class="alert alert-warning">
                        กรุณาตรวจสอบการจอง การเข้าพัก และงานทำความสะอาดของห้องนี้ก่อนเปลี่ยนสถานะ
                        @if (!string.IsNullOrEmpty(Model.OriginalPreMaintenanceStatus))
                        {
                            <span>สถานะก่อนซ่อม: @ThaiText.Status(Model.OriginalPreMaintenanceStatus)</span>
                        }
                        <div class="form-check mt-2">
                            <input asp-for="ConfirmMaintenanceReview" class="form-check-input" />
                            <label asp-for="ConfirmMaintenanceReview" class="form-check-label">ตรวจสอบแล้ว</label>
                        </div>
                        <span asp-validation-for="ConfirmMaintenanceReview" class="text-danger"></span>
                    </div>
                </div>
            }
            <div class="col-12">
                <div class="mb-3">
                    <label asp-for="Image" class="form-label">รูปห้อง</label>
                    <input asp-for="Image"
                           type="file"
                           class="form-control"
                           accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" />
                    <span asp-validation-for="Image" class="text-danger"></span>
                    <div class="form-text">ไฟล์ JPG, PNG หรือ WEBP ขนาดไม่เกิน 5 MB</div>
                    <img id="roomImagePreview"
                         src="@Url.Content(Model.ImagePath ?? "~/images/default-room.svg")"
                         alt="ตัวอย่างรูปห้อง"
                         class="room-image mt-3 rounded"
                         style="width: 100%; max-width: 420px; object-fit: cover;"
                         onerror="this.onerror=null;this.src='@Url.Content("~/images/default-room.svg")';" />
                </div>
            </div>
            <div class="col-12">
                <div class="mb-3">
                    <label asp-for="Description" class="form-label">รายละเอียดห้อง</label>
                    <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>
            </div>
            <div class="col-12">
                <button type="submit" class="btn btn-primary">
                    @(isEdit ? "บันทึก" : "เพิ่มห้อง")
                </button>
                <a asp-controller="Admin" asp-action="Rooms" class="btn btn-secondary">
                    ยกเลิก
                </a>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const roomImageInput = document.getElementById("@Html.IdFor(model => model.Image)");
        const roomImagePreview = document.getElementById("roomImagePreview");
        let previewUrl;

        roomImageInput?.addEventListener("change", () => {
            const image = roomImageInput.files?.[0];
            if (!image) {
                if (previewUrl) {
                    URL.revokeObjectURL(previewUrl);
                    previewUrl = undefined;
                }
                roomImagePreview.src = "@Url.Content(Model.ImagePath ?? "~/images/default-room.svg")";
                return;
            }

            if (previewUrl) {
                URL.revokeObjectURL(previewUrl);
            }
            previewUrl = URL.createObjectURL(image);
            roomImagePreview.src = previewUrl;
        });
    </script>
}
