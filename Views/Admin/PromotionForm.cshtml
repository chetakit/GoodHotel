@* ฟอร์มเพิ่ม/แก้โปร (ใช้ร่วมกัน) *@
@using GoodHotel.Services
@model GoodHotel.Models.ViewModels.PromotionFormViewModel

@{
    var isEdit = Model.PromotionId.HasValue;
    ViewData["Title"] = isEdit ? "แก้ไขโปรโมชัน" : "เพิ่มโปรโมชัน";
}

<div class="booking-panel" style="max-width: 820px">

    <form asp-action="@(isEdit ? "EditPromotion" : "AddPromotion")" method="post">
        @if (isEdit)
        {
            <input asp-for="PromotionId" type="hidden" />
        }
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

        @* ---------- 1. ข้อมูลโปร ---------- *@
        <h5 class="mt-2">1. ข้อมูลโปร</h5>
        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="PromotionName" class="form-label">ชื่อโปรโมชัน</label>
                <input asp-for="PromotionName" class="form-control" maxlength="100" placeholder="เช่น Early Bird 30 วัน" />
                <span asp-validation-for="PromotionName" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Description" class="form-label">คำอธิบาย (แสดงให้ลูกค้าเห็น)</label>
                <input asp-for="Description" class="form-control" maxlength="255" />
            </div>
        </div>

        @* ---------- 2. เงื่อนไข ---------- *@
        <h5 class="mt-4">2. เงื่อนไข</h5>
        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="RuleType" class="form-label">ประเภทโปร</label>
                <select asp-for="RuleType" id="rule-type" class="form-select">
                    <option value="">-- เลือก --</option>
                    @foreach (var (key, rule) in PromotionRules.All)
                    {
                        <option value="@key" data-value-label="@rule.ValueLabel">@rule.Label</option>
                    }
                </select>
                <span asp-validation-for="RuleType" class="text-danger"></span>
            </div>
            <div class="col-md-6" id="rule-value-group">
                <label asp-for="RuleValue" class="form-label" id="rule-value-label">ตัวเลขเงื่อนไข</label>
                <input asp-for="RuleValue" type="number" min="1" max="365" class="form-control" />
                <span asp-validation-for="RuleValue" class="text-danger"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="StartDate" class="form-label">เข้าพักได้ตั้งแต่ (ไม่บังคับ)</label>
                <input asp-for="StartDate" type="date" class="form-control" />
                <span asp-validation-for="StartDate" class="text-danger"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="EndDate" class="form-label">ถึงวันที่ (ไม่บังคับ)</label>
                <input asp-for="EndDate" type="date" class="form-control" />
                <span asp-validation-for="EndDate" class="text-danger"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="MinSpend" class="form-label">ค่าห้องขั้นต่ำ (บาท, ไม่บังคับ)</label>
                <input asp-for="MinSpend" type="number" min="0" step="0.01" class="form-control" />
                <span asp-validation-for="MinSpend" class="text-danger"></span>
            </div>
        </div>

        @* ---------- 3. ส่วนลด ---------- *@
        <h5 class="mt-4">3. ส่วนลด</h5>
        <div class="row g-3 align-items-end">
            <div class="col-md-4">
                <label class="form-label d-block">ลดเป็น</label>
                <div class="btn-group" role="group">
                    <input type="radio" class="btn-check" asp-for="DiscountType" value="@PromotionRules.Percent" id="type-percent" />
                    <label class="btn btn-outline-primary" for="type-percent">% เปอร์เซ็นต์</label>
                    <input type="radio" class="btn-check" asp-for="DiscountType" value="@PromotionRules.Fixed" id="type-fixed" />
                    <label class="btn btn-outline-primary" for="type-fixed">฿ บาท</label>
                </div>
            </div>
            <div class="col-md-4">
                <label asp-for="DiscountValue" class="form-label" id="discount-value-label">มูลค่าส่วนลด</label>
                <input asp-for="DiscountValue" type="number" min="0.01" step="0.01" class="form-control" />
                <span asp-validation-for="DiscountValue" class="text-danger"></span>
            </div>
            <div class="col-md-4" id="max-discount-group">
                <label asp-for="MaxDiscount" class="form-label">ลดสูงสุด (บาท, ไม่บังคับ)</label>
                <input asp-for="MaxDiscount" type="number" min="0" step="0.01" class="form-control" />
            </div>
        </div>

        <div class="form-check form-switch mt-4">
            <input asp-for="IsActive" class="form-check-input" />
            <label asp-for="IsActive" class="form-check-label">เปิดใช้งานโปรนี้</label>
        </div>

        <div class="d-flex gap-2 mt-4">
            <button type="submit" class="btn btn-primary hotel-primary-btn">บันทึก</button>
            <a asp-action="Promotion" class="btn btn-outline-secondary">ยกเลิก</a>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        // เปลี่ยนป้ายช่อง "ตัวเลขเงื่อนไข" ตามประเภทโปร และซ่อนเมื่อโปรนั้นไม่ต้องใช้ตัวเลข
        (() => {
            const ruleType = document.getElementById("rule-type");
            const valueGroup = document.getElementById("rule-value-group");
            const valueLabel = document.getElementById("rule-value-label");
            const maxGroup = document.getElementById("max-discount-group");
            const discountLabel = document.getElementById("discount-value-label");

            const updateRule = () => {
                const label = ruleType.selectedOptions[0]?.dataset.valueLabel;
                valueGroup.hidden = !label;
                valueLabel.textContent = label || "";
            };

            const updateDiscount = () => {
                const isPercent = document.getElementById("type-percent").checked;
                maxGroup.hidden = !isPercent;
                discountLabel.textContent = isPercent ? "ลดกี่ %" : "ลดกี่บาท";
            };

            ruleType.addEventListener("change", updateRule);
            document.querySelectorAll('[name="DiscountType"]')
                .forEach(radio => radio.addEventListener("change", updateDiscount));
            updateRule();
            updateDiscount();
        })();
    </script>
}
