@model IEnumerable<GoodHotel.Models.ViewModels.PromotionListViewModel>

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Promotions";
}

<div class="table-panel">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4 class="mb-0">Promotion management</h4>
        <a asp-controller="Admin"
           asp-action="AddPromotion"
           class="btn btn-primary hotel-primary-btn">
            + Add promotion
        </a>
    </div>

    @if (TempData["PromotionSuccessMessage"] is string successMessage)
    {
        <div class="alert alert-success" role="alert">@successMessage</div>
    }

    @if (TempData["PromotionErrorMessage"] is string errorMessage)
    {
        <div class="alert alert-danger" role="alert">@errorMessage</div>
    }

    @if (!Model.Any())
    {
        <p class="text-center text-muted mb-0">No promotions found.</p>
    }
    else
    {
        <div class="row g-4">
            @foreach (var promotion in Model)
            {
                <div class="col-lg-6">
                    <div class="promo-card">
                        <span class="tag">@promotion.PromotionId</span>
                        <h4>@promotion.PromotionName</h4>
                        @if (promotion.IsLegacyPromotion)
                        {
                            <span class="badge bg-secondary mb-2">Legacy Promotion</span>
                        }
                        else if (promotion.MetadataError != null)
                        {
                            <span class="badge bg-danger mb-2">Invalid metadata</span>
                            <p class="text-danger small">@promotion.MetadataError</p>
                        }
                        else if (promotion.PromotionCode != null)
                        {
                            <div class="mb-2">
                                <span class="badge bg-primary">@promotion.PromotionCode</span>
                                <span class="badge @(promotion.IsActive == true ? "bg-success" : "bg-secondary")">
                                    @(promotion.IsActive == true ? "Active" : "Inactive")
                                </span>
                            </div>
                            <p class="mb-2">
                                <strong>Discount:</strong>
                                @if (promotion.DiscountType == "PERCENT")
                                {
                                    <span>@promotion.DiscountValue?.ToString("0.##")%</span>
                                }
                                else
                                {
                                    <span>฿@promotion.DiscountValue?.ToString("N2")</span>
                                }
                            </p>
                            <small class="text-muted d-block mb-2">
                                @if (promotion.StartDate.HasValue &&
                                     promotion.EndDate.HasValue)
                                {
                                    <span>
                                        Booking dates:
                                        @promotion.StartDate.Value.ToString(
                                            "yyyy-MM-dd",
                                            System.Globalization.CultureInfo.InvariantCulture)
                                        –
                                        @promotion.EndDate.Value.ToString(
                                            "yyyy-MM-dd",
                                            System.Globalization.CultureInfo.InvariantCulture)
                                    </span>
                                }
                                else
                                {
                                    <span>Booking dates: Not specified</span>
                                }
                            </small>
                        }
                        @if (!string.IsNullOrWhiteSpace(promotion.Benefit))
                        {
                            <p class="text-muted">@promotion.Benefit</p>
                        }
                        @if (!string.IsNullOrWhiteSpace(promotion.Description))
                        {
                            <p>@promotion.Description</p>
                        }
                        @if (!string.IsNullOrWhiteSpace(promotion.Condition))
                        {
                            <small class="text-muted">Condition: @promotion.Condition</small>
                        }
                        <div class="mt-3 d-flex gap-2">
                            <a asp-controller="Admin"
                               asp-action="EditPromotion"
                               asp-route-id="@promotion.PromotionId"
                               class="btn btn-outline-secondary btn-sm">
                                Edit
                            </a>
                            <form asp-controller="Admin"
                                  asp-action="DeletePromotion"
                                  method="post"
                                  onsubmit="return confirm('Delete this promotion?');">
                                <input type="hidden" name="id" value="@promotion.PromotionId" />
                                <button type="submit" class="btn btn-outline-danger btn-sm">
                                    Delete
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
