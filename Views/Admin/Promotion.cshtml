@* รายการโปรของ Admin *@
@model IReadOnlyList<GoodHotel.Models.ViewModels.PromotionListViewModel>

@{
    ViewData["Title"] = "โปรโมชัน";
}

@section Actions {
    <a asp-action="AddPromotion" class="btn btn-primary btn-sm">เพิ่มโปรโมชัน</a>
}

<div>
    <p class="text-muted small mb-3">
        1 การจองใช้ได้ 1 โปร ระบบจะเลือกโปรที่ลดได้มากที่สุดให้ลูกค้าอัตโนมัติ · ส่วนลดคิดจากค่าห้อง (ไม่รวมเตียงเสริม)
    </p>

    @if (TempData["PromotionSuccessMessage"] is string success)
    {
        <div class="alert alert-success" role="status">@success</div>
    }
    @if (TempData["PromotionErrorMessage"] is string error)
    {
        <div class="alert alert-danger" role="alert">@error</div>
    }

    @if (Model.Count == 0)
    {
        <p class="text-center text-muted mb-0">ยังไม่มีโปรโมชัน</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th>โปรโมชัน</th>
                        <th>เงื่อนไข</th>
                        <th>ส่วนลด</th>
                        <th>สถานะ</th>
                        <th class="text-end">จัดการ</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var promotion in Model)
                    {
                        <tr class="@(promotion.IsActive ? "" : "text-muted")">
                            <td>
                                <strong>@promotion.PromotionName</strong>
                                <div class="small text-muted">@promotion.RuleLabel</div>
                            </td>
                            <td class="small">
                                @if (promotion.NeedsSetup)
                                {
                                    <span class="badge text-bg-warning">โปรเก่า ยังไม่ได้ตั้งเงื่อนไข · ลูกค้ายังใช้ไม่ได้</span>
                                }
                                else
                                {
                                    @promotion.ConditionText
                                }
                            </td>
                            <td><strong>@promotion.DiscountText</strong></td>
                            <td>
                                <span class="badge @(promotion.IsActive ? "text-bg-success" : "text-bg-secondary")">
                                    @(promotion.IsActive ? "เปิดใช้งาน" : "ปิด")
                                </span>
                            </td>
                            <td class="text-end">
                                <div class="d-inline-flex gap-1">
                                    <a asp-action="EditPromotion" asp-route-id="@promotion.PromotionId"
                                       class="btn btn-outline-secondary btn-sm">แก้ไข</a>
                                    <form asp-action="TogglePromotion" method="post">
                                        <input type="hidden" name="id" value="@promotion.PromotionId" />
                                        <button type="submit" class="btn btn-outline-primary btn-sm">
                                            @(promotion.IsActive ? "ปิด" : "เปิด")
                                        </button>
                                    </form>
                                    <form asp-action="DeletePromotion" method="post"
                                          onsubmit="return confirm('ลบโปร @promotion.PromotionName ?');">
                                        <input type="hidden" name="id" value="@promotion.PromotionId" />
                                        <button type="submit" class="btn btn-outline-danger btn-sm">ลบ</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
