@model GoodHotel.Models.ViewModels.EmployeeProfileViewModel

@{
    ViewData["Title"] = "ข้อมูลพนักงาน";
}

<div>
    @if (TempData["EmployeeSuccess"] is string success)
    {
        <div class="alert alert-success" role="status">@success</div>
    }
    @if (TempData["EmployeeError"] is string error)
    {
        <div class="alert alert-danger" role="alert">@error</div>
    }
    <div class="card">
        <div class="card-header">
            <h4 class="mb-0">ข้อมูลพนักงาน</h4>
        </div>
        <div class="card-body">
            <dl class="row mb-0">
                <dt class="col-sm-3">รหัส</dt>
                <dd class="col-sm-9">@Model.UserId</dd>

                <dt class="col-sm-3">ชื่อ</dt>
                <dd class="col-sm-9">@Model.FirstName @Model.LastName</dd>

                <dt class="col-sm-3">อีเมล</dt>
                <dd class="col-sm-9">@Model.Email</dd>

                <dt class="col-sm-3">เบอร์โทร</dt>
                <dd class="col-sm-9">@Model.Phone</dd>

                <dt class="col-sm-3">วันเกิด</dt>
                <dd class="col-sm-9">@ThaiText.Date(Model.BirthDate)</dd>

                <dt class="col-sm-3">บทบาท</dt>
                <dd class="col-sm-9">@ThaiText.Status(Model.Role)</dd>

                <dt class="col-sm-3">สถานะ</dt>
                <dd class="col-sm-9">@(Model.IsActive ? "ใช้งานอยู่" : "ปิดการใช้งาน")</dd>
            </dl>
        </div>
        <div class="card-footer">
            <form asp-action="SetEmployeeActive" method="post" class="d-inline">
                <input type="hidden" name="id" value="@Model.UserId" />
                <input type="hidden" name="isActive" value="@(Model.IsActive ? "false" : "true")" />
                <button type="submit" class="btn @(Model.IsActive ? "btn-outline-danger" : "btn-outline-success")">
                    @(Model.IsActive ? "ปิดการใช้งาน" : "เปิดการใช้งาน")
                </button>
            </form>
            <a asp-controller="Admin"
               asp-action="Employees"
               class="btn btn-secondary">
                กลับไปรายชื่อพนักงาน
            </a>
        </div>
    </div>
</div>
