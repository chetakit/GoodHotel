@model IEnumerable<GoodHotel.Models.ViewModels.RoomListViewModel>

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "ห้องพัก";
}

<style>
    .room-status {
        white-space: nowrap;
        background: #e9ecef;
        color: #343a40;
    }

    .room-status--available {
        background: #d1e7dd;
        color: #0f5132;
    }

    .room-status--occupied {
        background: #f8d7da;
        color: #842029;
    }

    .room-status--reserved {
        background: #ffe5cc;
        color: #804000;
    }

    .room-status--maintenance {
        background: #e9ecef;
        color: #343a40;
    }
</style>

<div class="table-panel">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4 class="mb-0">จัดการห้องพัก</h4>
        <a asp-controller="Admin"
           asp-action="AddRoom"
           class="btn btn-primary hotel-primary-btn">
            + เพิ่มห้อง
        </a>
    </div>

    @if (TempData["RoomSuccessMessage"] is string successMessage)
    {
        <div class="alert alert-success" role="alert">@successMessage</div>
    }

    @if (TempData["RoomErrorMessage"] is string errorMessage)
    {
        <div class="alert alert-danger" role="alert">@errorMessage</div>
    }

    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th>รูป</th>
                    <th>ห้อง</th>
                    <th>ประเภท</th>
                    <th>รับได้</th>
                    <th>สถานะตอนนี้</th>
                    <th title="ค่าที่ Admin ตั้งเอง ใช้ปิดขายห้องหรือตั้งเป็นซ่อมบำรุง">สถานะที่ตั้งไว้</th>
                    <th>ราคา/คืน</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="8" class="text-center text-muted">
                            ยังไม่มีห้องพัก
                        </td>
                    </tr>
                }
                else
                {
                    var live = (Dictionary<int, RoomStatusItem>)ViewBag.LiveStatus;
                    @foreach (var room in Model)
                    {
                        var statusClass = room.Status?.Trim().ToUpperInvariant() switch
                        {
                            "AVAILABLE" => "room-status--available",
                            "OCCUPIED" => "room-status--occupied",
                            "RESERVED" => "room-status--reserved",
                            "MAINTENANCE" => "room-status--maintenance",
                            _ => ""
                        };

                        <tr>
                            <td>
                                <img src="@room.ImagePath"
                                     alt="Room @room.RoomNumber"
                                     class="rounded"
                                     style="width: 96px; height: 64px; object-fit: cover;"
                                     onerror="this.onerror=null;this.src='@Url.Content("~/images/default-room.svg")';" />
                            </td>
                            <td>@room.RoomNumber</td>
                            <td>@room.Type</td>
                            <td>@(room.Capacity is int capacity ? $"{capacity} คน" : "")</td>
                            <td>
                                @if (live.TryGetValue(room.RoomId, out var now))
                                {
                                    <strong>@RoomStatusService.Label(now.Status)</strong>
                                    @if (!string.IsNullOrEmpty(now.Detail)) { <br /><small class="text-muted">@now.Detail</small> }
                                }
                            </td>
                            <td>
                                <span class="status-pill room-status @statusClass">@ThaiText.Status(room.Status)</span>
                            </td>
                            <td>@(room.Rate.HasValue ? $"฿{room.Rate.Value:N2}" : "")</td>
                            <td>
                                <a asp-controller="Admin"
                                   asp-action="EditRoom"
                                   asp-route-id="@room.RoomId"
                                   class="btn btn-sm btn-outline-secondary">
                                    แก้ไข
                                </a>
                                <form asp-controller="Admin"
                                      asp-action="DeleteRoom"
                                      method="post"
                                      class="d-inline"
                                      onsubmit="return confirm('ลบห้องนี้?');">
                                    <input type="hidden" name="id" value="@room.RoomId" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                        ลบ
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
