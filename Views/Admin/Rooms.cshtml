@model IEnumerable<GoodHotel.Models.ViewModels.RoomListViewModel>

@{
    ViewData["Title"] = "ห้องพัก";
}

@section Actions {
    <a asp-controller="Admin" asp-action="AddRoom" class="btn btn-primary btn-sm">เพิ่มห้อง</a>
}

<div>

    @if (TempData["RoomSuccessMessage"] is string successMessage)
    {
        <div class="alert alert-success" role="alert">@successMessage</div>
    }

    @if (TempData["RoomErrorMessage"] is string errorMessage)
    {
        <div class="alert alert-danger" role="alert">@errorMessage</div>
    }

    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th>รูป</th>
                    <th>ห้อง</th>
                    <th>ประเภท</th>
                    <th>รับได้</th>
                    <th title="คำนวณจากการจอง การเข้าพัก งานทำความสะอาด และงานซ่อมจริง">สถานะจริงตอนนี้</th>
                    <th title="ค่าที่ Admin ตั้งเอง: เปิดให้ลูกค้าจอง หรือปิดขายห้องไว้">การเปิดขาย (Admin ตั้ง)</th>
                    <th>ราคา/คืน</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="8" class="text-center text-muted">
                            ยังไม่มีห้องพัก
                        </td>
                    </tr>
                }
                else
                {
                    var live = (Dictionary<int, RoomStatusItem>)ViewBag.LiveStatus;
                    @foreach (var room in Model)
                    {
                        var statusClass = room.Status?.Trim().ToUpperInvariant() switch
                        {
                            "AVAILABLE" => "text-bg-success",
                            "OCCUPIED" or "RESERVED" => "text-bg-warning",
                            "MAINTENANCE" => "text-bg-danger",
                            _ => "text-bg-secondary"
                        };

                        <tr>
                            <td>
                                <img src="@room.ImagePath"
                                     alt="ห้อง @room.RoomNumber"
                                     class="rounded"
                                     style="width: 96px; height: 64px; object-fit: cover;"
                                     onerror="this.onerror=null;this.src='@Url.Content("~/images/default-room.svg")';" />
                            </td>
                            <td>@room.RoomNumber</td>
                            <td>@room.Type</td>
                            <td>@(room.Capacity is int capacity ? $"{capacity} คน" : "")</td>
                            <td>
                                @if (live.TryGetValue(room.RoomId, out var now))
                                {
                                    <span class="badge live-status tone-@RoomStatusService.Tone(now.Status)">@RoomStatusService.Label(now.Status)</span>
                                    @if (!string.IsNullOrEmpty(now.Detail)) { <div class="text-muted small mt-1">@now.Detail</div> }
                                }
                            </td>
                            <td>
                                @* แสดงเป็น "เปิดขาย/ปิดขาย" ไม่ใช่ "ว่าง" เพื่อไม่ให้ขัดกับสถานะจริง (เช่น มีแขกพักอยู่แต่ Admin เปิดขายไว้) *@
                                <span class="badge @statusClass">@(room.Status?.Trim().ToUpperInvariant() switch
                                {
                                    "AVAILABLE" => "เปิดขาย",
                                    "MAINTENANCE" => "ปิด · ซ่อมบำรุง",
                                    "RESERVED" or "OCCUPIED" => "ปิดขาย",
                                    _ => ThaiText.Status(room.Status)
                                })</span>
                            </td>
                            <td>@(room.Rate.HasValue ? $"฿{room.Rate.Value:N2}" : "")</td>
                            <td>
                                <a asp-controller="Admin"
                                   asp-action="EditRoom"
                                   asp-route-id="@room.RoomId"
                                   class="btn btn-sm btn-outline-secondary">
                                    แก้ไข
                                </a>
                                <form asp-controller="Admin"
                                      asp-action="DeleteRoom"
                                      method="post"
                                      class="d-inline"
                                      onsubmit="return confirm('ลบห้องนี้?');">
                                    <input type="hidden" name="id" value="@room.RoomId" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                        ลบ
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
