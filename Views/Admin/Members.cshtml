
@model IEnumerable<GoodHotel.Models.ViewModels.MemberListViewModel>

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "สมาชิก";
    const int pageSize = 10;
    const string pageCookie = "AdminMembersPage";
    // แยกดูได้ว่า ลูกค้า หรือ พนักงาน (Staff/แม่บ้าน/Admin)
    var roleFilter = Context.Request.Query["role"].ToString();
    var members = Model
        .Where(m => roleFilter == "customer" ? m.Role == "Customer"
                  : roleFilter == "staff" ? m.Role != "Customer"
                  : true)
        .OrderBy(member => member.UserId).ToList();
    var myId = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
    var totalPages = Math.Max(1, (int)Math.Ceiling(members.Count / (double)pageSize));
    var requestedPage = Context.Request.Query.ContainsKey("page")
        ? Context.Request.Query["page"].ToString()
        : Context.Request.Cookies[pageCookie];
    var currentPage = int.TryParse(requestedPage, out var page)
        ? Math.Clamp(page, 1, totalPages)
        : 1;
    Context.Response.Cookies.Append(pageCookie, currentPage.ToString(), new Microsoft.AspNetCore.Http.CookieOptions
    {
        HttpOnly = true,
        IsEssential = true,
        SameSite = Microsoft.AspNetCore.Http.SameSiteMode.Lax,
        Secure = Context.Request.IsHttps,
        Path = Url.Action("Members", "Admin") ?? "/Admin/Members"
    });
}

<div class="container mt-4">
    <h2 class="mb-3">สมาชิก</h2>

    <ul class="nav nav-pills mb-4">
        <li class="nav-item"><a class="nav-link @(roleFilter == "" ? "active" : "")" asp-action="Members" asp-route-page="1">ทั้งหมด</a></li>
        <li class="nav-item"><a class="nav-link @(roleFilter == "customer" ? "active" : "")" asp-action="Members" asp-route-role="customer" asp-route-page="1">ลูกค้า</a></li>
        <li class="nav-item"><a class="nav-link @(roleFilter == "staff" ? "active" : "")" asp-action="Members" asp-route-role="staff" asp-route-page="1">พนักงาน</a></li>
    </ul>

    @if (TempData["SuccessMessage"] is string successMessage)
    {
        <div class="alert alert-success" role="alert">@successMessage</div>
    }
    @if (TempData["MemberError"] is string memberError)
    {
        <div class="alert alert-danger" role="alert">@memberError</div>
    }

    @if (Context.Request.Query["status"] == "EditSuccess")
        {
            <div class="alert alert-success">
                แก้ไขข้อมูลสมาชิกสำเร็จ!
            </div>
        }
        else if (Context.Request.Query["status"] == "EditFailed")
        {
            <div class="alert alert-danger">
                ไม่พบสมาชิกที่ต้องการแก้ไข
            </div>
        }
        else if (Context.Request.Query["status"] == "DeleteSuccess")
        {
            <div class="alert alert-success">
                ลบสมาชิกสำเร็จ!
            </div>
        }
        else if (Context.Request.Query["status"] == "DeleteFailed")
        {
            <div class="alert alert-danger">
                ไม่พบสมาชิกที่ต้องการลบ
            </div>
}

    <table class="table table-bordered">
        <thead>
            <tr>
                <th>รหัส</th>
                <th>ชื่อ</th>
                <th>อีเมล</th>
                <th>เบอร์โทร</th>
                <th>บทบาท</th>
                <th></th>
            </tr>
        </thead>

        <tbody>
            @foreach (var item in members.Skip((currentPage - 1) * pageSize).Take(pageSize))
            {
                <tr>
                    <td>@item.UserId</td>
                    <td>@item.FirstName @item.LastName</td>
                    <td>@item.Email</td>
                    <td>@item.Phone</td>
                    <td>@ThaiText.Status(item.Role)</td>
                    <td>
                    <a asp-controller="Admin"
                    asp-action="EditUser"
                    asp-route-id="@item.UserId"
                    class="btn btn-primary">
                        แก้ไข
                    </a>

                    @if (item.UserId.ToString() == myId)
                    {
                        <span class="text-muted small ms-1">(บัญชีของคุณ)</span>
                    }
                    else
                    {
                    <form asp-controller="Admin"
                        asp-action="DeleteUser"
                        method="post"
                        style="display: inline;"
                        onsubmit="return confirm('ต้องการลบสมาชิกคนนี้หรือไม่?');">

                        <input type="hidden" name="id" value="@item.UserId" />

                        <button type="submit" class="btn btn-danger">
                            ลบ
                        </button>
                    </form>
                    }
                </td>
                </tr>
            }
        </tbody>

        <tfoot>
            <tr>
                <th colspan="6">รวม @members.Count คน</th>
            </tr>
        </tfoot>
    </table>
    @if (totalPages > 1)
    {
        <nav aria-label="Member pages" class="mt-4">
            <ul class="pagination flex-wrap mb-0">
                <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                    @if (currentPage == 1)
                    {
                        <span class="page-link">ก่อนหน้า</span>
                    }
                    else
                    {
                        <a class="page-link" asp-action="Members" asp-route-role="@roleFilter" asp-route-page="@(currentPage - 1)">ก่อนหน้า</a>
                    }
                </li>
                @for (var pageNumber = 1; pageNumber <= totalPages; pageNumber++)
                {
                    <li class="page-item @(pageNumber == currentPage ? "active" : "")">
                        @if (pageNumber == currentPage)
                        {
                            <span class="page-link" aria-current="page">@pageNumber</span>
                        }
                        else
                        {
                            <a class="page-link" asp-action="Members" asp-route-role="@roleFilter" asp-route-page="@pageNumber">@pageNumber</a>
                        }
                    </li>
                }
                <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                    @if (currentPage == totalPages)
                    {
                        <span class="page-link">ถัดไป</span>
                    }
                    else
                    {
                        <a class="page-link" asp-action="Members" asp-route-role="@roleFilter" asp-route-page="@(currentPage + 1)">ถัดไป</a>
                    }
                </li>
            </ul>
        </nav>
    }
</div>
