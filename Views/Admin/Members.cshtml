
@model IEnumerable<GoodHotel.Models.ViewModels.MemberListViewModel>

@{
    ViewData["Title"] = "บัญชีผู้ใช้";
    const int pageSize = 10;
    // แยกดูได้ว่า ลูกค้า หรือ พนักงาน (Staff/แม่บ้าน/บัญชี/Admin) และค้นหาด้วยชื่อ อีเมล หรือเบอร์
    var roleFilter = Context.Request.Query["role"].ToString();
    var search = Context.Request.Query["q"].ToString().Trim();
    var members = Model.ToList();
    var myId = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
    var totalPages = Math.Max(1, (int)Math.Ceiling(members.Count / (double)pageSize));
    var currentPage = int.TryParse(Context.Request.Query["page"], out var page) ? Math.Clamp(page, 1, totalPages) : 1;
}

@section Actions {
    <a asp-action="AddUser" class="btn btn-primary btn-sm">เพิ่มผู้ใช้</a>
}

<div>

    <form method="get" asp-action="Members" class="toolbar">
        @if (roleFilter != "")
        {
            <input type="hidden" name="role" value="@roleFilter" />
        }
        <div>
            <label class="form-label" for="q">ค้นหา</label>
            <input id="q" name="q" class="form-control" value="@search" placeholder="ชื่อ อีเมล หรือเบอร์โทร" maxlength="100" />
        </div>
        <button type="submit" class="btn btn-primary">ค้นหา</button>
        @if (search != "")
        {
            <a class="btn btn-outline-secondary" asp-action="Members" asp-route-role="@roleFilter">ล้าง</a>
        }
    </form>

    <ul class="nav nav-pills mb-3">
        <li class="nav-item"><a class="nav-link @(roleFilter == "" ? "active" : "")" asp-action="Members" asp-route-q="@search">ทั้งหมด</a></li>
        <li class="nav-item"><a class="nav-link @(roleFilter == "customer" ? "active" : "")" asp-action="Members" asp-route-role="customer" asp-route-q="@search">ลูกค้า</a></li>
        <li class="nav-item"><a class="nav-link @(roleFilter == "staff" ? "active" : "")" asp-action="Members" asp-route-role="staff" asp-route-q="@search">พนักงาน</a></li>
    </ul>

    @if (TempData["SuccessMessage"] is string successMessage)
    {
        <div class="alert alert-success" role="alert">@successMessage</div>
    }
    @if (TempData["MemberError"] is string memberError)
    {
        <div class="alert alert-danger" role="alert">@memberError</div>
    }

    @if (Context.Request.Query["status"] == "EditSuccess")
        {
            <div class="alert alert-success">
                แก้ไขข้อมูลสมาชิกสำเร็จ!
            </div>
        }
        else if (Context.Request.Query["status"] == "EditFailed")
        {
            <div class="alert alert-danger">
                ไม่พบสมาชิกที่ต้องการแก้ไข
            </div>
        }
        else if (Context.Request.Query["status"] == "DeleteSuccess")
        {
            <div class="alert alert-success">
                ลบสมาชิกสำเร็จ!
            </div>
        }
        else if (Context.Request.Query["status"] == "DeleteFailed")
        {
            <div class="alert alert-danger">
                ไม่พบสมาชิกที่ต้องการลบ
            </div>
}

    <section class="table-panel">
    <div class="table-responsive">
    <table class="table table-hover">
        <thead>
            <tr>
                <th>รหัส</th>
                <th>ชื่อ</th>
                <th>อีเมล</th>
                <th>เบอร์โทร</th>
                <th>บทบาท</th>
                <th>สถานะ</th>
                <th></th>
            </tr>
        </thead>

        <tbody>
            @foreach (var item in members.Skip((currentPage - 1) * pageSize).Take(pageSize))
            {
                <tr>
                    <td>@item.UserId</td>
                    <td>@item.FirstName @item.LastName</td>
                    <td>@item.Email</td>
                    <td>@item.Phone</td>
                    <td>@ThaiText.Status(item.Role)</td>
                    <td><span class="badge @(item.IsActive ? "text-bg-success" : "text-bg-secondary")">@(item.IsActive ? "ใช้งานอยู่" : "ปิดการใช้งาน")</span></td>
                    <td class="text-nowrap">
                    <a asp-controller="Admin"
                    asp-action="EditUser"
                    asp-route-id="@item.UserId"
                    class="btn btn-sm btn-outline-primary">
                        แก้ไข
                    </a>

                    @if (item.UserId.ToString() == myId)
                    {
                        <span class="text-muted small ms-1">(บัญชีของคุณ)</span>
                    }
                    else
                    {
                    <form asp-controller="Admin"
                        asp-action="DeleteUser"
                        method="post"
                        style="display: inline;"
                        onsubmit="return confirm('ต้องการลบสมาชิกคนนี้หรือไม่?');">

                        <input type="hidden" name="id" value="@item.UserId" />

                        <button type="submit" class="btn btn-sm btn-outline-danger">
                            ลบ
                        </button>
                    </form>
                    }
                </td>
                </tr>
            }
        </tbody>

        <tfoot>
            <tr>
                <th colspan="7">@(members.Count == 0 ? "ไม่พบผู้ใช้ที่ค้นหา" : $"รวม {members.Count} คน")</th>
            </tr>
        </tfoot>
    </table>
    </div>
    </section>
    @if (totalPages > 1)
    {
        <nav aria-label="หน้ารายชื่อผู้ใช้" class="mt-4">
            <ul class="pagination flex-wrap mb-0">
                <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                    @if (currentPage == 1)
                    {
                        <span class="page-link">ก่อนหน้า</span>
                    }
                    else
                    {
                        <a class="page-link" asp-action="Members" asp-route-role="@roleFilter" asp-route-q="@search" asp-route-page="@(currentPage - 1)">ก่อนหน้า</a>
                    }
                </li>
                @for (var pageNumber = 1; pageNumber <= totalPages; pageNumber++)
                {
                    <li class="page-item @(pageNumber == currentPage ? "active" : "")">
                        @if (pageNumber == currentPage)
                        {
                            <span class="page-link" aria-current="page">@pageNumber</span>
                        }
                        else
                        {
                            <a class="page-link" asp-action="Members" asp-route-role="@roleFilter" asp-route-q="@search" asp-route-page="@pageNumber">@pageNumber</a>
                        }
                    </li>
                }
                <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                    @if (currentPage == totalPages)
                    {
                        <span class="page-link">ถัดไป</span>
                    }
                    else
                    {
                        <a class="page-link" asp-action="Members" asp-route-role="@roleFilter" asp-route-q="@search" asp-route-page="@(currentPage + 1)">ถัดไป</a>
                    }
                </li>
            </ul>
        </nav>
    }
</div>
