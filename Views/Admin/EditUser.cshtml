
@model GoodHotel.Models.ViewModels.EditUserViewModel

@{
    ViewData["Title"] = "แก้ไขผู้ใช้";
}

<div class="booking-panel" style="max-width: 720px">

    <form asp-controller="Admin" asp-action="EditUser" method="post">
        <input type="hidden" asp-for="UserId" />
        <div asp-validation-summary="All" class="text-danger"></div>

        <div class="mb-3">
            <label asp-for="FirstName" class="form-label">ชื่อ</label>
            <input asp-for="FirstName" class="form-control" />
            <span asp-validation-for="FirstName" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="LastName" class="form-label">นามสกุล</label>
            <input asp-for="LastName" class="form-control" />
            <span asp-validation-for="LastName" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Email" class="form-label">อีเมล</label>
            <input asp-for="Email" type="email" class="form-control" />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>

       
<div class="mb-3">
    <label asp-for="Phone" class="form-label">เบอร์โทร</label>
    <input asp-for="Phone"
           class="form-control"
           type="tel"
           inputmode="numeric"
           maxlength="10"
           oninput="this.value = this.value.replace(/[^0-9]/g, '').slice(0, 10)"
           required />
    <span asp-validation-for="Phone" class="text-danger"></span>
    <small class="text-muted">ตัวเลข 9-10 หลัก ขึ้นต้นด้วย 0</small>
</div>


        <div class="mb-3">
            <label asp-for="Role" class="form-label">บทบาท</label>
            @if (User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value == Model.UserId.ToString())
            {
                @* แก้บัญชีตัวเอง: เปลี่ยนบทบาทไม่ได้ (เซิร์ฟเวอร์ก็บังคับใช้ค่าเดิมอยู่แล้ว) *@
                <input type="hidden" asp-for="Role" />
                <input class="form-control" value="@ThaiText.Status(Model.Role)" disabled />
                <div class="form-text">เปลี่ยนบทบาทของบัญชีตัวเองไม่ได้ ให้ Admin คนอื่นเปลี่ยนให้</div>
            }
            else
            {
                <select asp-for="Role" class="form-select">
                    <option value="Customer">ลูกค้า</option>
                    <option value="Staff">พนักงานต้อนรับ</option>
                    <option value="Housekeeper">แม่บ้าน</option>
                    <option value="Accountant">ฝ่ายบัญชี</option>
                    <option value="Admin">ผู้ดูแลระบบ</option>
                </select>
            }
            <span asp-validation-for="Role" class="text-danger"></span>
        </div>

        @if (User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value != Model.UserId.ToString())
        {
            <div class="mb-3">
                <label asp-for="NewPassword" class="form-label">ตั้งรหัสผ่านใหม่ (ไม่บังคับ)</label>
                <input asp-for="NewPassword" type="password" class="form-control" autocomplete="new-password" minlength="8" />
                <div class="form-text">ใช้เมื่อเจ้าของบัญชีลืมรหัส 8 ตัวอักษรขึ้นไป เว้นว่างถ้าไม่เปลี่ยน</div>
                <span asp-validation-for="NewPassword" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="ConfirmPassword" class="form-label">ยืนยันรหัสผ่านใหม่</label>
                <input asp-for="ConfirmPassword" type="password" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
            </div>
        }

        <button type="submit" class="btn btn-primary">บันทึก</button>
        <a asp-controller="Admin" asp-action="Members"
           class="btn btn-secondary">ยกเลิก</a>
    </form>
</div>
