@* หน้าภาพรวมของ Admin *@
@model GoodHotel.Models.ViewModels.AdminDashboardViewModel

@{
    ViewData["Title"] = "ภาพรวม";
}

@section Actions {
    <a class="btn btn-outline-secondary btn-sm" asp-action="Reports">รายงาน</a>
}

<div class="figures">
    <div class="figure">
        <a asp-action="Rooms"><div class="label">ห้องพัก</div><div class="value">@Model.RoomCount</div></a>
    </div>
    <div class="figure">
        <a asp-action="Members"><div class="label">บัญชีผู้ใช้</div><div class="value">@Model.UserCount</div></a>
    </div>
    <div class="figure">
        <div class="label">การจอง</div>
        <div class="value">@Model.BookingCount</div>
        <div class="note">ไม่นับที่ยกเลิก</div>
    </div>
    <div class="figure">
        <div class="label">เงินรับสุทธิ</div>
        <div class="value">฿@((Model.Revenue ?? 0m).ToString("N0"))</div>
        <div class="note">รายละเอียดอยู่ที่ฝ่ายบัญชี</div>
    </div>
</div>

<div class="figures">
    <div class="figure @(Model.PendingHousekeepingCount > 0 ? "is-alert" : "")">
        <div class="label">งานทำความสะอาดรอคนรับ</div>
        <div class="value">@Model.PendingHousekeepingCount</div>
    </div>
    <div class="figure @(Model.AwaitingVerificationCount > 0 ? "is-alert" : "")">
        <div class="label">ห้องรอพนักงานตรวจ</div>
        <div class="value">@Model.AwaitingVerificationCount</div>
    </div>
    <div class="figure @(Model.OpenMaintenanceCount > 0 ? "is-alert" : "")">
        <a asp-controller="Maintenance" asp-action="Index">
            <div class="label">งานซ่อมที่ยังไม่เสร็จ</div>
            <div class="value">@Model.OpenMaintenanceCount</div>
        </a>
    </div>
</div>

<div class="row g-3 mb-3">
    <div class="col-xl-7">
        <section class="table-panel h-100">
            <div class="panel-head">
                <h2>การจองตามวันเข้าพัก</h2>
                <span class="text-muted small">ย้อนหลัง 2 สัปดาห์ ถึงล่วงหน้า 2 สัปดาห์</span>
            </div>
            <partial name="_ColumnChart" model="@(new GoodHotel.Models.ViewModels.ColumnChartModel("bookings", Model.BookingsByDay, "การจอง"))" />
        </section>
    </div>
    <div class="col-xl-5">
        <section class="table-panel h-100">
            <div class="panel-head">
                <h2>ห้องที่มีแขกพัก 14 คืนข้างหน้า</h2>
                <span class="text-muted small">จาก @Model.RoomCount ห้อง</span>
            </div>
            <partial name="_ColumnChart" model="@(new GoodHotel.Models.ViewModels.ColumnChartModel("occupancy", Model.NightlyOccupancy, "ห้องที่มีแขก", Math.Max(1, Model.RoomCount)))" />
        </section>
    </div>
</div>

<div class="row g-3">
    <div class="col-xl-8">
        <section class="table-panel">
            <div class="panel-head"><h2>การจองล่าสุด</h2></div>
            @if (!Model.BookingsByCheckInDate.Any())
            {
                <p class="panel-empty">ยังไม่มีการจอง</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table">
                        <thead><tr><th>เลขที่</th><th>ลูกค้า</th><th>ห้อง</th><th>วันเข้าพัก</th><th class="text-end">ยอดรวม</th></tr></thead>
                        <tbody>
                            @foreach (var booking in Model.BookingsByCheckInDate)
                            {
                                <tr>
                                    <td>#@booking.BookingId</td>
                                    <td>@ThaiText.OrDash(booking.GuestName?.Trim())</td>
                                    <td>@ThaiText.OrDash(booking.RoomNumber)</td>
                                    <td class="num">@ThaiText.Date(booking.CheckIn)</td>
                                    <td class="text-end num">@(booking.Amount.HasValue ? $"฿{booking.Amount:N2}" : "-")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>
    </div>

    <div class="col-xl-4">
        <section class="table-panel">
            <div class="panel-head">
                <h2>สถานะห้องตอนนี้</h2>
                <a asp-action="Rooms">จัดการห้อง</a>
            </div>
            @if (!Model.RoomStatusCounts.Any())
            {
                <p class="panel-empty">ยังไม่มีห้องพัก</p>
            }
            else
            {
                @* แท่งแนวนอน 1 สี: ความยาว = จำนวนห้องเทียบกับห้องทั้งหมด ชื่อและตัวเลขเขียนกำกับทุกแถว *@
                <div class="py-2">
                    @foreach (var item in Model.RoomStatusCounts.OrderByDescending(i => i.Count))
                    {
                        var pct = Model.RoomCount == 0 ? 0 : item.Count * 100.0 / Model.RoomCount;
                        <div class="hbar-row">
                            <span>@ThaiText.OrDash(item.Status)</span>
                            <div class="hbar-track" title="@item.Status @item.Count จาก @Model.RoomCount ห้อง">
                                <div class="hbar-fill" style="width: @(pct.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture))%"></div>
                            </div>
                            <span class="text-end num fw-semibold">@item.Count</span>
                        </div>
                    }
                </div>
            }
        </section>
    </div>
</div>
