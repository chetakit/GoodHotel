@model GoodHotel.Models.ViewModels.AdminDashboardViewModel

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Dashboard";
}

<div class="row g-4">
    <div class="col-md-6 col-xl-3">
        <div class="stat-card">
            <div class="label">Rooms</div>
            <div class="value">@Model.RoomCount</div>
            <div class="trend">Total room records</div>
        </div>
    </div>
    <div class="col-md-6 col-xl-3">
        <div class="stat-card">
            <div class="label">User accounts</div>
            <div class="value">@Model.UserCount</div>
            <div class="trend">All roles</div>
        </div>
    </div>
    <div class="col-md-6 col-xl-3">
        <div class="stat-card">
            <div class="label">Bookings</div>
            <div class="value">@Model.BookingCount</div>
            <div class="trend">Total booking records</div>
        </div>
    </div>
    <div class="col-md-6 col-xl-3">
        <div class="stat-card">
            <div class="label">Recorded payment amount</div>
            <div class="value">@(Model.RecordedPaymentAmount?.ToString("N2") ?? "N/A")</div>
            <div class="trend">Includes all payment statuses</div>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-xl-8">
        <div class="table-panel">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h4 class="mb-0">Bookings by check-in date</h4>
                <a asp-controller="Admin" asp-action="Reports" class="btn btn-link p-0">View reports</a>
            </div>
            <div class="table-responsive">
                <table class="table align-middle">
                    <thead>
                        <tr>
                            <th>Booking ID</th>
                            <th>Guest</th>
                            <th>Room</th>
                            <th>Check-in</th>
                            <th>Booking amount</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.BookingsByCheckInDate.Any())
                        {
                            <tr>
                                <td colspan="5" class="text-center text-muted">
                                    No bookings with a check-in date.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var booking in Model.BookingsByCheckInDate)
                            {
                                <tr>
                                    <td>@booking.BookingId</td>
                                    <td>@booking.GuestName</td>
                                    <td>@booking.RoomNumber</td>
                                    <td>@booking.CheckIn?.ToString("yyyy-MM-dd")</td>
                                    <td>@(booking.Amount?.ToString("N2") ?? "")</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="col-xl-4">
        <div class="booking-summary">
            <h4 class="mb-3">Rooms by recorded status</h4>
            @if (!Model.RoomStatusCounts.Any())
            {
                <p class="text-muted mb-0">No room records.</p>
            }
            else
            {
                @foreach (var item in Model.RoomStatusCounts)
                {
                    <div class="summary-line">
                        <span>@(string.IsNullOrWhiteSpace(item.Status) ? "Unspecified" : item.Status)</span>
                        <strong>@item.Count</strong>
                    </div>
                }
            }
        </div>
    </div>
</div>

<div class="report-card mt-4">
    <h4 class="mb-2">Payment amount note</h4>
    <p class="text-muted mb-0">
        The amount above is the sum of payment records in the database. It includes every recorded payment status and is not classified as collected revenue.
    </p>
</div>
