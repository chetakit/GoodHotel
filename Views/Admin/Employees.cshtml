@* รายชื่อพนักงาน *@
@model IEnumerable<GoodHotel.Models.ViewModels.EmployeeListViewModel>

@{
    ViewData["Title"] = "พนักงาน";
    var employees = Model.ToList();
    var roles = new[] { "Staff", "Housekeeper", "Accountant" };
    var groups = roles.Select(role => new
    {
        Role = role,
        Employees = employees.Where(employee =>
            string.Equals(employee.Role, role, StringComparison.OrdinalIgnoreCase)).ToList()
    }).ToList();
    var otherEmployees = employees.Where(employee =>
        !roles.Any(role => string.Equals(employee.Role, role, StringComparison.OrdinalIgnoreCase))).ToList();
    if (otherEmployees.Count > 0)
    {
        groups.Add(new { Role = "อื่นๆ", Employees = otherEmployees });
    }
}

<div>

    @foreach (var group in groups)
    {
        <section class="mb-4">
            <h5>@ThaiText.Status(group.Role)</h5>
            <div class="table-responsive">
                <table class="table align-middle">
                    <thead>
                        <tr>
                            <th>รหัส</th>
                            <th>ชื่อ</th>
                            <th>อีเมล</th>
                            <th>เบอร์โทร</th>
                            <th>บทบาท</th>
                            <th>สถานะ</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (group.Employees.Count == 0)
                        {
                            <tr>
                                <td colspan="7" class="text-center text-muted">
                                    ไม่มีพนักงานตำแหน่งนี้
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var employee in group.Employees)
                            {
                                <tr>
                                    <td>@employee.UserId</td>
                                    <td>@employee.FirstName @employee.LastName</td>
                                    <td>@employee.Email</td>
                                    <td>@employee.Phone</td>
                                    <td>@ThaiText.Status(employee.Role)</td>
                                    <td><span class="badge @(employee.IsActive ? "text-bg-success" : "text-bg-secondary")">@(employee.IsActive ? "ใช้งานอยู่" : "ปิดการใช้งาน")</span></td>
                                    <td>
                                        <a asp-controller="Admin"
                                           asp-action="EmployeeProfile"
                                           asp-route-id="@employee.UserId"
                                           class="btn btn-sm btn-outline-secondary">
                                            ดูข้อมูล
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </section>
    }
</div>
