@* ฟอร์มเพิ่มบัญชี → AdminController.AddUser *@
@model GoodHotel.Models.User

@{
    ViewData["Title"] = "เพิ่มผู้ใช้";
}

<div class="booking-panel" style="max-width: 820px">

    <form asp-controller="Admin" asp-action="AddUser" method="post">
        <div asp-validation-summary="All" class="text-danger"></div>
        <div class="row">
            <div class="col-md-6">
                <div class="mb-3">
                    <label asp-for="FirstName" class="form-label">ชื่อ</label>
                    <input asp-for="FirstName" class="form-control" />
                    <span asp-validation-for="FirstName" class="text-danger"></span>
                </div>
            </div>
            <div class="col-md-6">
                <div class="mb-3">
                    <label asp-for="LastName" class="form-label">นามสกุล</label>
                    <input asp-for="LastName" class="form-control" />
                    <span asp-validation-for="LastName" class="text-danger"></span>
                </div>
            </div>
            <div class="col-md-6">
                <div class="mb-3">
                    <label asp-for="Email" class="form-label">อีเมล</label>
                    <input asp-for="Email" type="email" class="form-control" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>
            </div>
            <div class="col-md-6">
                <div class="mb-3">
                    <label asp-for="Phone" class="form-label">เบอร์โทร</label>
                    <input asp-for="Phone" type="tel" class="form-control" inputmode="numeric"
                           autocomplete="tel" placeholder="081 234 5678" maxlength="12"
                           aria-describedby="phoneHelp" />
                    <div id="phoneHelp" class="form-text">เบอร์มือถือ 10 หลัก ขึ้นต้นด้วย 06, 08 หรือ 09</div>
                    <span asp-validation-for="Phone" class="text-danger"></span>
                </div>
            </div>
            <div class="col-md-6">
                <div class="mb-3">
                    <label asp-for="Password" class="form-label">รหัสผ่าน</label>
                    <input asp-for="Password" type="password" class="form-control" minlength="8" autocomplete="new-password" aria-describedby="passwordHelp" />
                    <div id="passwordHelp" class="form-text">8 ตัวอักษรขึ้นไป</div>
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>
            </div>
            <div class="col-md-6">
                <div class="mb-3">
                    <label asp-for="BirthDate" class="form-label">วันเกิด</label>
                    <input asp-for="BirthDate" type="date" class="form-control" min="1900-01-01" max="@(GoodHotel.Services.RoomAvailabilityService.HotelDate(DateTime.UtcNow).ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture))" />
                    <span asp-validation-for="BirthDate" class="text-danger"></span>
                </div>
            </div>
            <div class="col-12">
                <div class="mb-3">
                    <label asp-for="Role" class="form-label">บทบาท</label>
                    <select asp-for="Role" class="form-select">
                        <option value="">-- เลือกบทบาท --</option>
                        <option value="Customer">ลูกค้า</option>
                        <option value="Staff">พนักงานต้อนรับ</option>
                        <option value="Housekeeper">แม่บ้าน</option>
                        <option value="Accountant">ฝ่ายบัญชี</option>
                        <option value="Admin">ผู้ดูแลระบบ</option>
                    </select>
                    <span asp-validation-for="Role" class="text-danger"></span>
                </div>
            </div>
            <div class="col-12">
                <button type="submit" class="btn btn-primary">เพิ่มผู้ใช้</button>
                <a asp-controller="Admin" asp-action="Members" class="btn btn-secondary">ยกเลิก</a>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    
<script>
    const phoneInput = document.getElementById("@Html.IdFor(model => model.Phone)");

    if (phoneInput) {
        phoneInput.addEventListener("input", () => {
            const digits = phoneInput.value.replace(/\D/g, "").slice(0, 10);

            phoneInput.value = digits.length > 6
                ? `${digits.slice(0, 3)} ${digits.slice(3, 6)} ${digits.slice(6)}`
                : digits.length > 3
                    ? `${digits.slice(0, 3)} ${digits.slice(3)}`
                    : digits;
        });
    }
</script>

}