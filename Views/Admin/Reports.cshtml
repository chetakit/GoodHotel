@model GoodHotel.Models.ViewModels.AdminReportsViewModel

@{
    ViewData["Title"] = "รายงาน";

    var from = Model.From?.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture);
    var to = Model.To?.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture);
    var maxPromo = Model.PromotionUsage.Select(p => p.BookingCount).DefaultIfEmpty(0).Max();
}

<form method="get" asp-action="Reports" class="toolbar">
    <div>
        <label class="form-label" for="from">ตั้งแต่</label>
        <input id="from" name="from" type="date" class="form-control" value="@from" />
    </div>
    <div>
        <label class="form-label" for="to">ถึง</label>
        <input id="to" name="to" type="date" class="form-control" value="@to" />
    </div>
    <button type="submit" class="btn btn-primary">ดูรายงาน</button>
    @if (from != null || to != null)
    {
        <a class="btn btn-outline-secondary" asp-action="Reports">ดูทั้งหมด</a>
    }
</form>

<div class="figures">
    <div class="figure">
        <div class="label">การจอง</div>
        <div class="value">@Model.BookingCount.ToString("N0")</div>
        <div class="note">ยกเลิกแล้ว @Model.CancelledBookingCount.ToString("N0") รายการ</div>
    </div>
    <div class="figure">
        <div class="label">ยกเลิกเพราะไม่ชำระตามกำหนด</div>
        <div class="value">@Model.PaymentTimeoutCount.ToString("N0")</div>
        <div class="note">ระบบยกเลิกอัตโนมัติ @PaymentDeadline.Window.TotalMinutes นาทีหลังจอง</div>
    </div>
    <div class="figure">
        <div class="label">ระยะเวลาเข้าพักเฉลี่ย</div>
        <div class="value">@(Model.AverageActualStayNights.HasValue ? $"{Model.AverageActualStayNights.Value:N1} คืน" : "-")</div>
        <div class="note">จากการเข้าพักที่เช็คเอาท์แล้ว @Model.CompletedStaysWithValidDates ครั้ง</div>
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-6">
        <section class="table-panel h-100">
            <div class="panel-head"><h2>งานทำความสะอาด</h2></div>
            @if (Model.HousekeepingByStatus.Count == 0)
            {
                <p class="panel-empty">ยังไม่มีงาน</p>
            }
            else
            {
                <table class="table">
                    <tbody>
                        @foreach (var item in Model.HousekeepingByStatus)
                        {
                            <tr><td><span class="badge @ThaiText.Badge(item.Status)">@ThaiText.Status(item.Status)</span></td><td class="text-end num">@item.Count</td></tr>
                        }
                    </tbody>
                </table>
            }
        </section>
    </div>
    <div class="col-lg-6">
        <section class="table-panel h-100">
            <div class="panel-head"><h2>งานซ่อม</h2></div>
            @if (Model.MaintenanceByStatus.Count == 0)
            {
                <p class="panel-empty">ยังไม่มีงานซ่อม</p>
            }
            else
            {
                <table class="table">
                    <tbody>
                        @foreach (var item in Model.MaintenanceByStatus)
                        {
                            <tr><td><span class="badge @ThaiText.Badge(item.Status)">@ThaiText.Status(item.Status)</span></td><td class="text-end num">@item.Count</td></tr>
                        }
                    </tbody>
                </table>
            }
        </section>
    </div>
    <div class="col-12">
        <section class="table-panel">
            <div class="panel-head">
                <h2>การใช้โปรโมชัน</h2>
                <a asp-action="Promotion">จัดการโปรโมชัน</a>
            </div>
            @if (Model.PromotionUsage.Count == 0)
            {
                <p class="panel-empty">ยังไม่มีการจองที่ใช้โปรโมชัน</p>
            }
            else
            {
                <div class="p-3">
                    @foreach (var promotion in Model.PromotionUsage)
                    {
                        <div class="bar-row">
                            <span>@promotion.PromotionName</span>
                            <div class="bar-track"><div class="bar-fill" style="width: @(maxPromo == 0 ? 0 : promotion.BookingCount * 100 / maxPromo)%"></div></div>
                            <span class="text-end num">@promotion.BookingCount การจอง</span>
                        </div>
                    }
                </div>
            }
        </section>
    </div>
</div>
<p class="text-muted small mt-2">การจองและโปรโมชันนับตามวันเข้าพัก ระยะเวลาเข้าพักนับตามวันเช็คเอาท์ งานนับตามวันที่สร้างหรือแจ้ง · ตัวเลขรายได้และการชำระเงินย้ายไปอยู่ที่หน้าฝ่ายบัญชี</p>
