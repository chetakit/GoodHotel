@model IReadOnlyList<GoodHotel.Models.ViewModels.StaffTaskViewModel>
@{
    ViewData["Title"] = "ตรวจงานทำความสะอาด";
}
<section class="content-section">
    <div class="container">
        <div class="section-heading"><span class="eyebrow text-dark">Front Desk</span><h2>งานทำความสะอาดที่รอตรวจ</h2></div>
        <p class="text-muted">ตรวจห้องที่แม่บ้านทำเสร็จแล้ว เมื่อกดตรวจผ่าน ห้องจะกลับมาว่างให้จองได้</p>
        @if (TempData["StaffSuccess"] is string success) { <div class="alert alert-success" role="status">@success</div> }
        @if (TempData["StaffError"] is string error) { <div class="alert alert-warning" role="alert">@error</div> }
        @if (Model.Count == 0)
        {
            <p>ไม่มีงานที่รอตรวจ</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table align-middle">
                    <thead><tr><th>งาน</th><th>ห้อง</th><th>ประเภท</th><th>ทำเสร็จเมื่อ</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var task in Model)
                        {
                            <tr>
                                <td>#@task.TaskId</td>
                                <td>@ThaiText.OrDash(task.RoomNumber)</td>
                                <td>@ThaiText.Status(task.TaskType)</td>
                                <td>@ThaiText.Time(task.CompletedAtUtc)</td>
                                <td><a asp-action="VerificationDetails" asp-route-id="@task.TaskId" class="btn btn-outline-primary">ดูรายละเอียด</a></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        <a asp-action="Index" class="btn btn-outline-primary">กลับแดชบอร์ด</a>
    </div>
</section>
