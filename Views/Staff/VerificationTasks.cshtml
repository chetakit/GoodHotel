@* รายการห้องรอตรวจ *@
@model IReadOnlyList<GoodHotel.Models.ViewModels.StaffTaskViewModel>
@{
    ViewData["Title"] = "ตรวจห้องหลังทำความสะอาด";
}

<p class="text-muted mb-3">ห้องที่แม่บ้านทำความสะอาดเสร็จแล้ว ตรวจแล้วกด "ตรวจผ่าน" ห้องจะพร้อมให้เข้าพัก</p>
@if (TempData["StaffSuccess"] is string success) { <div class="alert alert-success" role="status">@success</div> }
@if (TempData["StaffError"] is string error) { <div class="alert alert-warning" role="alert">@error</div> }

<section class="table-panel">
    <div class="panel-head">
        <h2>ห้องที่รอตรวจ</h2>
        <span class="text-muted small">@Model.Count ห้อง</span>
    </div>
    @if (Model.Count == 0)
    {
        <p class="panel-empty">ไม่มีห้องที่รอตรวจ</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover">
                <thead><tr><th>งาน</th><th>ห้อง</th><th>ประเภท</th><th>ทำเสร็จเมื่อ</th><th></th></tr></thead>
                <tbody>
                    @foreach (var task in Model)
                    {
                        <tr>
                            <td>#@task.TaskId</td>
                            <td>@ThaiText.OrDash(task.RoomNumber)</td>
                            <td>@ThaiText.Status(task.TaskType)</td>
                            <td class="num">@ThaiText.Time(task.CompletedAtUtc)</td>
                            <td class="text-end"><a asp-action="VerificationDetails" asp-route-id="@task.TaskId" class="btn btn-sm btn-primary">ตรวจห้อง</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>
