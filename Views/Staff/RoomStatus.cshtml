@using GoodHotel.Services
@model IReadOnlyList<RoomStatusItem>

@{
    ViewData["Title"] = "สถานะห้อง";
    var today = (DateOnly)ViewBag.Today;

    string Label(RoomLiveStatus status) => RoomStatusService.Label(status);

    string Tone(RoomLiveStatus status) => status switch
    {
        RoomLiveStatus.Available => "ok",
        RoomLiveStatus.ArrivingToday => "accent",
        RoomLiveStatus.Occupied => "info",
        RoomLiveStatus.Cleaning => "warn",
        RoomLiveStatus.Maintenance => "bad",
        _ => "none"
    };
}

<p class="text-muted mb-3">ข้อมูล ณ @ThaiText.Date(today) (เวลาไทย) · คิดจากการเข้าพัก งานทำความสะอาด และงานซ่อมจริง</p>

<div class="figures">
    @foreach (var status in Enum.GetValues<RoomLiveStatus>())
    {
        <div class="figure">
            <div class="label"><span class="tone-dot tone-@Tone(status)"></span>@Label(status)</div>
            <div class="value">@Model.Count(r => r.Status == status)</div>
        </div>
    }
</div>

@if (Model.Count == 0)
{
    <div class="alert alert-light">ยังไม่มีข้อมูลห้องพัก</div>
}
else
{
    <div class="room-board">
        @foreach (var room in Model)
        {
            <div class="room-tile tone-@Tone(room.Status)">
                <div class="d-flex justify-content-between align-items-baseline gap-2">
                    <strong class="room-tile-number">@room.RoomNumber</strong>
                    <span class="room-tile-status">@Label(room.Status)</span>
                </div>
                <div class="text-muted small">@ThaiText.OrDash(room.RoomType) · @room.Capacity คน</div>
                @if (!string.IsNullOrWhiteSpace(room.Detail))
                {
                    <div class="small mt-2">@room.Detail</div>
                }
                @if (room.BookingId.HasValue)
                {
                    <a asp-action="BookingDetails" asp-route-id="@room.BookingId" class="small d-inline-block mt-2">การจอง #@room.BookingId</a>
                }
            </div>
        }
    </div>
}
