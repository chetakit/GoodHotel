@model IReadOnlyList<GoodHotel.Controllers.StaffController.BookingListItem>

@{
    ViewData["Title"] = "รายการจอง";
}

<section class="content-section">
    <div class="container">
        <div class="section-heading">
            <p class="text-muted">ค้นหาและตรวจสอบการจองของลูกค้า</p>
        </div>

        <div class="booking-panel mb-4">
            <form asp-controller="Staff" asp-action="Bookings" method="get" class="row g-3 align-items-end">
                <div class="col-sm-6 col-lg-5">
                    <label for="q" class="form-label">ค้นหา</label>
                    <input id="q" name="q" type="search" class="form-control"
                           placeholder="ชื่อลูกค้า, เบอร์โทร หรือ #เลขที่การจอง"
                           value="@Context.Request.Query["q"]" />
                </div>
                <div class="col-sm-6 col-lg-3">
                    <label for="when" class="form-label">แสดง</label>
                    @{ var when = Context.Request.Query["when"].ToString(); }
                    <select id="when" name="when" class="form-select" onchange="this.form.submit()">
                        <option value="" selected="@(when == "")">ทั้งหมด</option>
                        <option value="today" selected="@(when == "today")">เข้า/ออกวันนี้</option>
                        <option value="staying" selected="@(when == "staying")">กำลังเข้าพัก</option>
                        <option value="noshow" selected="@(when == "noshow")">ไม่มาเข้าพัก</option>
                        <option value="upcoming" selected="@(when == "upcoming")">กำลังจะมาถึง</option>
                    </select>
                </div>
                <div class="col-auto">
                    <button type="submit" class="btn btn-primary">ค้นหา</button>
                    <a asp-controller="Staff" asp-action="Bookings" class="btn btn-outline-primary">ล้าง</a>
                </div>
            </form>
        </div>

        @if (ViewData.ModelState.IsValid)
        {
            @if (Model.Count == 0)
            {
                <div class="alert alert-light border" role="status">ไม่พบการจอง</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table align-middle">
                        <thead>
                            <tr>
                                <th>เลขที่</th>
                                <th>ลูกค้า</th>
                                <th>ห้อง</th>
                                <th>วันเข้าพัก</th>
                                <th>วันออก</th>
                                <th>ผู้เข้าพัก</th>
                                <th>ยอดรวม</th>
                                <th>สถานะ</th>
                                <th>การชำระเงิน</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var booking in Model)
                            {
                                var customerName = $"{booking.FirstName} {booking.LastName}".Trim();
                                var isCancelled = booking.BookingStatus == BookingStatuses.Cancelled;
                                <tr>
                                    <td>#@booking.BookingId</td>
                                    <td>@ThaiText.OrDash(customerName)</td>
                                    <td>@ThaiText.OrDash(booking.RoomNumber)</td>
                                    <td>@ThaiText.Date(booking.CheckIn)</td>
                                    <td>@ThaiText.Date(booking.CheckOut)</td>
                                    <td>@(booking.Guests?.ToString() ?? "-")</td>
                                    <td>@(booking.Amount.HasValue ? $"฿{booking.Amount:N2}" : "-")</td>
                                    <td>
                                        @* รวมสถานะการจองกับสถานะเข้าพักเป็นป้ายเดียว *@
                                        @{
                                            var (label, color) = isCancelled
                                                ? (booking.CancelReason == CancelReasons.PaymentTimeout ? "ยกเลิก · หมดเวลาชำระ" : "ยกเลิกแล้ว", "text-bg-secondary")
                                                : booking.StayStatus == "CheckedIn" ? ("เข้าพักอยู่", "text-bg-success")
                                                : booking.StayStatus == "CheckedOut" ? ("เช็คเอาท์แล้ว", "text-bg-dark")
                                                : booking.CheckOut <= (DateOnly)ViewBag.Today ? ("ไม่มาเข้าพัก", "text-bg-warning")
                                                : ("รอเช็คอิน", "text-bg-primary");
                                        }
                                        <span class="badge @color">@label</span>
                                    </td>
                                    <td>
                                        <span class="badge @(booking.PaymentLabel == PaymentService.PaidLabel ? "text-bg-success" : booking.PaymentLabel == PaymentService.RefundedLabel ? "text-bg-secondary" : "text-bg-warning")">
                                            @* ลูกค้ายกเลิกเองหลังจ่าย: โรงแรมไม่คืนเงิน บอกให้ชัดว่าไม่มีอะไรค้าง *@
                                            @(isCancelled && booking.PaymentLabel == PaymentService.PaidLabel ? "จ่ายแล้ว (ไม่คืนเงิน)" : booking.PaymentLabel)
                                        </span>
                                        @if (booking.RefundPending) { <span class="badge text-bg-warning">ขอคืนเงินอยู่</span> }
                                        @if (!isCancelled && booking.CheckOut > (DateOnly)ViewBag.Today && booking.PaymentLabel == "ยังไม่จ่าย" && booking.StayStatus == null &&
                                             PaymentDeadline.DueAtUtc(booking.CreatedAtUtc) is DateTime due)
                                        {
                                            <div class="small text-muted mt-1">ต้องจ่ายภายใน @ThaiText.Time(due)[11..]</div>
                                        }
                                    </td>
                                    <td>
                                        <a asp-controller="Staff" asp-action="BookingDetails"
                                           asp-route-id="@booking.BookingId" class="btn btn-sm btn-outline-primary">ดูรายละเอียด</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        }

    </div>
</section>
