@model GoodHotel.Models.ViewModels.StaffTaskViewModel
@{
    ViewData["Title"] = "รายละเอียดงานทำความสะอาด";
}
<section class="content-section">
    <div class="container">
        <div class="section-heading"><span class="eyebrow text-dark">Front Desk</span><h2>งานทำความสะอาด #@Model.TaskId</h2></div>
        <dl>
            <dt>ห้อง</dt><dd>@ThaiText.OrDash(Model.RoomNumber)</dd>
            <dt>ประเภทห้อง</dt><dd>@ThaiText.OrDash(Model.RoomType)</dd>
            <dt>ประเภทงาน</dt><dd>@ThaiText.Status(Model.TaskType)</dd>
            <dt>สถานะ</dt><dd>@ThaiText.Status(Model.Status)</dd>
            <dt>ทำโดยผู้ใช้ #</dt><dd>@(Model.CompletedByUserId?.ToString() ?? "-")</dd>
            <dt>ทำเสร็จเมื่อ</dt><dd>@ThaiText.Time(Model.CompletedAtUtc)</dd>
        </dl>
        @if (Model.Status == "Completed")
        {
            <form asp-action="VerifyTask" asp-route-id="@Model.TaskId" method="post">
                <button class="btn btn-primary" type="submit">ตรวจผ่าน</button>
            </form>
        }
        <a asp-action="VerificationTasks" class="btn btn-outline-primary mt-3">กลับไปรายการงาน</a>
    </div>
</section>
