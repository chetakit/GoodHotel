@* หน้าตรวจห้อง *@
@model GoodHotel.Models.ViewModels.StaffTaskViewModel
@{
    ViewData["Title"] = $"ตรวจห้อง · งาน #{Model.TaskId}";
}
<section class="content-section">
    <div class="container">
        <dl>
            <dt>ห้อง</dt><dd>@ThaiText.OrDash(Model.RoomNumber)</dd>
            <dt>ประเภทห้อง</dt><dd>@ThaiText.OrDash(Model.RoomType)</dd>
            <dt>ประเภทงาน</dt><dd>@ThaiText.Status(Model.TaskType)</dd>
            <dt>สถานะ</dt><dd><span class="badge @ThaiText.Badge(Model.Status)">@ThaiText.Status(Model.Status)</span></dd>
            <dt>ทำโดย</dt><dd>@(await Users.NameAsync(Model.CompletedByUserId))</dd>
            <dt>ทำเสร็จเมื่อ</dt><dd>@ThaiText.Time(Model.CompletedAtUtc)</dd>
        </dl>
        @if (Model.Status == "Completed")
        {
            <form asp-action="VerifyTask" asp-route-id="@Model.TaskId" method="post">
                <button class="btn btn-primary" type="submit">ตรวจผ่าน</button>
            </form>
            <form asp-action="ReworkTask" asp-route-id="@Model.TaskId" method="post" class="booking-panel mt-3">
                <label class="form-label" for="rework-reason">ตรวจไม่ผ่าน ต้องแก้อะไร (แม่บ้านเห็น)</label>
                <input id="rework-reason" name="reason" class="form-control" maxlength="500" required />
                <button class="btn btn-outline-danger mt-2" type="submit">ส่งกลับให้ทำใหม่</button>
            </form>
        }
        <a asp-action="VerificationTasks" class="btn btn-outline-primary mt-3">กลับไปรายการงาน</a>
    </div>
</section>
