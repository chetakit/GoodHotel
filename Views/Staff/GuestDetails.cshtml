@model GoodHotel.Controllers.StaffController.GuestDetailsModel

@{
    ViewData["Title"] = "ข้อมูลลูกค้า";
}

<section class="content-section">
    <div class="container">
        <div class="section-heading">
            <span class="eyebrow text-dark">Front Desk</span>
            <h2>ข้อมูลลูกค้า</h2>
            <p class="text-muted">การจอง #@Model.BookingId</p>
        </div>

        @if (!Model.HasGuest)
        {
            <div class="alert alert-light border" role="status">ไม่พบข้อมูลลูกค้าของการจองนี้</div>
        }
        else
        {
            <div class="booking-panel">
                <dl class="row mb-0">
                    <dt class="col-sm-5 col-lg-4">ชื่อ</dt>
                    <dd class="col-sm-7 col-lg-8">@ThaiText.OrDash(Model.FirstName)</dd>
                    <dt class="col-sm-5 col-lg-4">นามสกุล</dt>
                    <dd class="col-sm-7 col-lg-8">@ThaiText.OrDash(Model.LastName)</dd>
                    <dt class="col-sm-5 col-lg-4">อีเมล</dt>
                    <dd class="col-sm-7 col-lg-8">@ThaiText.OrDash(Model.Email)</dd>
                    <dt class="col-sm-5 col-lg-4">เบอร์โทร</dt>
                    <dd class="col-sm-7 col-lg-8">@ThaiText.OrDash(Model.Phone)</dd>
                    <dt class="col-sm-5 col-lg-4">วันเกิด</dt>
                    <dd class="col-sm-7 col-lg-8">@ThaiText.Date(Model.BirthDate)</dd>
                </dl>
            </div>
        }

        <nav class="d-flex flex-wrap gap-2 mt-4">
            <a asp-action="BookingDetails" asp-route-id="@Model.BookingId" class="btn btn-outline-primary">กลับไปที่การจอง</a>
            <a asp-action="Bookings" class="btn btn-outline-primary">กลับไปรายการจอง</a>
        </nav>
    </div>
</section>
