@model GoodHotel.Models.ViewModels.WalkInViewModel

@{
    ViewData["Title"] = "รับลูกค้า Walk-in";
    // <input type="date"> ต้องการปี ค.ศ. เสมอ จึงใช้ InvariantCulture (เครื่องที่ตั้งภาษาไทยจะได้ปี พ.ศ.)
    var iso = System.Globalization.CultureInfo.InvariantCulture;
    var minCheckOut = Model.Today.AddDays(1).ToString("yyyy-MM-dd", iso);
    var checkOutValue = Model.CheckOut?.ToString("yyyy-MM-dd", iso);
}

<section class="content-section">
    <div class="container">
        <div class="section-heading">
            <p class="text-muted">เข้าพักวันนี้ (@Model.Today.ToString("dd/MM/yyyy", iso)) · รับเงินสดและเช็คอินให้ทันที</p>
        </div>

        <div asp-validation-summary="ModelOnly" class="alert alert-warning" role="alert"></div>

        @* ขั้นที่ 1: เลือกวันออก / จำนวนคน เพื่อกรองห้องว่าง *@
        <form asp-action="WalkIn" method="get" class="booking-panel mb-4 row g-3 align-items-end">
            <div class="col-sm-5 col-lg-3">
                <label class="form-label" for="filterCheckOut">วันที่ออก</label>
                <input id="filterCheckOut" name="checkOut" type="date" class="form-control"
                       min="@minCheckOut" value="@checkOutValue" />
            </div>
            <div class="col-sm-4 col-lg-2">
                <label class="form-label" for="filterGuests">จำนวนผู้เข้าพัก</label>
                <input id="filterGuests" name="guests" type="number" min="1" max="20" class="form-control"
                       value="@Model.Guests" />
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-outline-primary">ค้นหาห้องว่าง</button>
            </div>
        </form>

        @* ขั้นที่ 2: เลือกห้อง + กรอกข้อมูลลูกค้า *@
        <form asp-action="WalkIn" method="post">
            <input type="hidden" name="CheckOut" value="@checkOutValue" />
            <input type="hidden" asp-for="Guests" />

            <h3 class="h5">1. เลือกห้อง (ว่าง @Model.AvailableRooms.Count ห้อง)</h3>
            <span asp-validation-for="RoomId" class="text-danger d-block mb-2"></span>
            @if (Model.AvailableRooms.Count == 0)
            {
                <div class="alert alert-light border">ไม่มีห้องว่างตามเงื่อนไขนี้ ลองเปลี่ยนวันที่ออกหรือจำนวนคน</div>
            }
            <div class="row g-3 mb-4">
                @foreach (var room in Model.AvailableRooms)
                {
                    <div class="col-sm-6 col-lg-3">
                        <label class="card h-100 p-3" style="cursor:pointer">
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="RoomId" value="@room.RoomId"
                                       checked="@(Model.RoomId == room.RoomId)" />
                                <strong>ห้อง @room.RoomNumber</strong>
                            </div>
                            <small class="text-muted">@room.RoomType · รับได้ @room.Capacity คน</small>
                            <strong class="mt-1">@(room.Rate.HasValue ? $"฿{room.Rate.Value:N0}" : "-") <span class="text-muted small fw-normal">/คืน</span></strong>
                        </label>
                    </div>
                }
            </div>

            <h3 class="h5">2. ข้อมูลลูกค้า</h3>
            <div class="booking-panel row g-3">
                <div class="col-md-6">
                    <label asp-for="FirstName" class="form-label">ชื่อ</label>
                    <input asp-for="FirstName" class="form-control" />
                    <span asp-validation-for="FirstName" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="LastName" class="form-label">นามสกุล</label>
                    <input asp-for="LastName" class="form-control" />
                    <span asp-validation-for="LastName" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Phone" class="form-label">เบอร์โทร</label>
                    <input asp-for="Phone" class="form-control" placeholder="0812345678" />
                    <small class="text-muted">ถ้าเบอร์และชื่อตรงกับลูกค้าเดิม ระบบจะใช้บัญชีเดิม</small>
                    <span asp-validation-for="Phone" class="text-danger d-block"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Email" class="form-label">อีเมล (ไม่บังคับ)</label>
                    <input asp-for="Email" class="form-control" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>
                <div class="col-12">
                    <div class="form-check">
                        <input asp-for="ExtraBed" class="form-check-input" />
                        <label asp-for="ExtraBed" class="form-check-label">เสริมเตียง 1 เตียง (+฿500/คืน)</label>
                    </div>
                </div>
            </div>

            @if (Model.Candidates.Count > 0)
            {
                <fieldset class="alert alert-warning mt-3 mb-0">
                    <legend class="h6">เบอร์นี้มีลูกค้าอยู่แล้ว ลูกค้าที่มาคือใคร?</legend>
                    <input type="hidden" name="CustomerChoiceFor" value="@Model.CustomerKey" />
                    @foreach (var customer in Model.Candidates)
                    {
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="CustomerChoice" id="customer-@customer.UserId" value="@customer.UserId" required />
                            <label class="form-check-label" for="customer-@customer.UserId">
                                @ThaiText.OrDash($"{customer.FirstName} {customer.LastName}".Trim())
                                <span class="text-muted small">(ลูกค้า #@customer.UserId · @(customer.CanLogin ? "สมัครสมาชิกแล้ว" : "เคยมา Walk-in"))</span>
                            </label>
                        </div>
                    }
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="CustomerChoice" id="customer-new" value="0" required />
                        <label class="form-check-label" for="customer-new">ไม่ใช่คนในรายการ สร้างลูกค้าใหม่</label>
                    </div>
                </fieldset>
            }

            <h3 class="h5 mt-4">3. เงินสดที่ต้องเก็บ</h3>
            <div class="booking-panel" id="walkin-quote" data-url="@Url.Action("WalkInQuote")" aria-live="polite">
                <p class="text-muted mb-0" data-quote-message>เลือกห้องเพื่อดูยอดที่ต้องเก็บ</p>
                <div data-quote-lines hidden>
                    <div class="summary-line"><span>ค่าห้อง <span data-quote-nights></span> คืน</span><strong data-quote-room></strong></div>
                    <div class="summary-line"><span>ส่วนลด <span class="text-muted small" data-quote-promo></span></span><strong data-quote-discount></strong></div>
                    <div class="summary-line"><span>เตียงเสริม</span><strong data-quote-bed></strong></div>
                    <div class="summary-line"><span class="fw-bold">ยอดที่ต้องเก็บ</span><strong class="fs-5" data-quote-total></strong></div>
                    <p class="text-muted small mb-0 mt-2" data-quote-note></p>
                </div>
            </div>
            <input type="hidden" name="ExpectedTotal" id="walkin-expected" value="" />

            <button type="submit" class="btn btn-primary btn-lg mt-4" disabled="@(Model.AvailableRooms.Count == 0)">
                ยืนยัน · รับเงินสด · เช็คอิน
            </button>
        </form>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // ยอดที่ต้องเก็บ: ถามเซิร์ฟเวอร์ทุกครั้งที่เปลี่ยนห้อง เตียงเสริม หรือลูกค้า (ใช้สูตรเดียวกับตอนบันทึก)
        (() => {
            const box = document.getElementById("walkin-quote");
            const expected = document.getElementById("walkin-expected");
            const form = box?.closest("form");
            if (!form) return;
            const part = name => box.querySelector("[data-quote-" + name + "]");
            const money = value => "฿" + Number(value || 0).toLocaleString("en-US", { minimumFractionDigits: 2 });
            let latest = 0, timer;

            const message = text => {
                part("message").textContent = text;
                part("message").hidden = false;
                part("lines").hidden = true;
            };

            const refresh = async () => {
                const current = ++latest;
                expected.value = "";
                if (!form.querySelector("[name=RoomId]:checked")) { message("เลือกห้องเพื่อดูยอดที่ต้องเก็บ"); return; }
                message("กำลังคำนวณยอด…");
                try {
                    const response = await fetch(box.dataset.url, { method: "POST", body: new FormData(form) });
                    const quote = await response.json();
                    if (current !== latest) return;
                    if (!quote.succeeded) { message(quote.message); return; }
                    part("nights").textContent = quote.nights;
                    part("room").textContent = money(quote.roomSubtotal);
                    part("promo").textContent = quote.promotionName || "";
                    part("discount").textContent = "-" + money(quote.discount);
                    part("bed").textContent = money(quote.extraBed);
                    part("total").textContent = money(quote.total);
                    part("note").textContent = quote.isFinal ? "" : "กรอกชื่อ นามสกุล และเบอร์ให้ครบ ส่วนลดอาจเปลี่ยนตามประวัติลูกค้า";
                    if (quote.isFinal) expected.value = quote.total;
                    part("message").hidden = true;
                    part("lines").hidden = false;
                } catch {
                    if (current === latest) message("คำนวณยอดไม่สำเร็จ ลองเลือกห้องอีกครั้ง");
                }
            };

            form.addEventListener("input", event => {
                expected.value = "";
                latest++;
                clearTimeout(timer);
                timer = setTimeout(refresh, event.target.matches("[type=radio], [type=checkbox]") ? 0 : 500);
            });
            refresh();
        })();
    </script>
}
