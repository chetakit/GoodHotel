
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Good Hotel</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="hotel-body">
    <header class="top-header">
        <nav class="navbar navbar-expand-lg navbar-light hotel-navbar">
            <div class="container">
                <a class="navbar-brand hotel-brand"
                   asp-controller="Home" asp-action="Index">
                    <span class="brand-mark">G</span>
                    <span>Good Hotel</span>
                </a>

                <button class="navbar-toggler" type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNavbar"
                        aria-controls="mainNavbar"
                        aria-expanded="false"
                        aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNavbar">
                    <ul class="navbar-nav mx-auto align-items-lg-center gap-lg-2">
                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Home" asp-action="Index">Home</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Home" asp-action="Rooms">Rooms</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Home" asp-action="Promotion">Promotion</a>
                        </li>

                        @if (User.IsInRole("Customer"))
                        {
                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Home" asp-action="Rooms">Booking</a>
                            </li>
                        }
                        else if (User.IsInRole("Staff"))
                        {
                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Staff" asp-action="Index">Staff Dashboard</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Staff" asp-action="Bookings">Bookings</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Staff" asp-action="MaintenanceReports">Maintenance</a>
                            </li>
                        }
                        else if (User.IsInRole("Housekeeper"))
                        {
                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Housekeeper" asp-action="Index">Dashboard</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Housekeeper" asp-action="Tasks">Cleaning Tasks</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Housekeeper" asp-action="MaintenanceReports">Maintenance</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Housekeeper" asp-action="MaintenanceHistory">History</a>
                            </li>
                        }
                    </ul>

                    <div class="d-flex align-items-center gap-2">
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <div class="dropdown">
                                <button class="btn btn-light dropdown-toggle d-flex
                                               align-items-center gap-2"
                                        type="button"
                                        id="userDropdown"
                                        data-bs-toggle="dropdown"
                                        aria-expanded="false">

                                    <span class="text-end">
                                        <span class="d-block fw-semibold">
                                            @User.Identity.Name
                                        </span>
                                        <small class="text-muted">
                                            @User.FindFirst(
                                                System.Security.Claims.ClaimTypes.Role
                                            )?.Value
                                        </small>
                                    </span>
                                </button>

                                <ul class="dropdown-menu dropdown-menu-end shadow border-0 mt-2"
                                    aria-labelledby="userDropdown">

                                    @if (User.IsInRole("Customer"))
                                    {
                                        <li>
                                            <a class="dropdown-item py-2"
                                               asp-controller="Home"
                                               asp-action="MyBookings">
                                                ประวัติการจอง (My Bookings)
                                            </a>
                                        </li>
                                    }
                                    else if (User.IsInRole("Admin"))
                                    {
                                        <li>
                                            <a class="dropdown-item py-2"
                                               asp-controller="Admin"
                                               asp-action="Dashboard">
                                                Admin Manage
                                            </a>
                                        </li>
                                    }
                                    else if (User.IsInRole("Staff"))
                                    {
                                        <li>
                                            <a class="dropdown-item py-2"
                                               asp-controller="Staff"
                                               asp-action="Index">
                                                Staff Dashboard
                                            </a>
                                        </li>
                                    }
                                    else if (User.IsInRole("Housekeeper"))
                                    {
                                        <li>
                                            <a class="dropdown-item py-2"
                                               asp-controller="Housekeeper"
                                               asp-action="Index">
                                                Housekeeper Dashboard
                                            </a>
                                        </li>
                                    }

                                    <li>
                                        <hr class="dropdown-divider" />
                                    </li>

                                    <li>
                                        <form asp-controller="Home"
                                              asp-action="Logout"
                                              method="post">
                                            <button type="submit"
                                                    class="dropdown-item text-danger py-2">
                                                Logout
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </div>
                        }
                        else
                        {
                            <a class="btn btn-outline-primary hotel-secondary-btn"
                               asp-controller="Home" asp-action="Login">
                                Login
                            </a>

                            <a class="btn btn-primary hotel-primary-btn"
                               asp-controller="Home" asp-action="Register">
                                Register
                            </a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <main>
        @RenderBody()
    </main>

    <footer class="hotel-footer">
        <div class="container">
            <div class="row gy-4 align-items-center">
                <div class="col-lg-4">
                    <a class="navbar-brand hotel-brand footer-brand"
                       asp-controller="Home" asp-action="Index">
                        <span class="brand-mark">G</span>
                        <span>Good Hotel</span>
                    </a>

                    <p class="footer-copy mt-3">
                        Stay beautifully. Discover comfort, calm, and the warmth of
                        service in every detail.
                    </p>
                </div>

                <div class="col-lg-4 text-lg-center">
                    <h6>Contact</h6>
                    <p class="footer-copy mb-1">+66 2 555 8900</p>
                    <p class="footer-copy mb-0">hello@goodhotel.com</p>
                </div>

                <div class="col-lg-4 text-lg-end">
                    <h6>Location</h6>
                    <p class="footer-copy mb-0">
                        86 Sukhumvit Road, Bangkok
                    </p>
                </div>
            </div>

            <div class="footer-bottom">
                <span>© 2026 Good Hotel</span>
                <span>Luxury • Comfort • Service</span>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
