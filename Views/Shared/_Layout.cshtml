@* โครงหน้าฝั่งลูกค้า: แถบเมนู + เนื้อหา (RenderBody) + ส่วนท้าย *@
@inject GoodHotel.Services.CustomerNotices Notices
@inject GoodHotel.Models.GoodHotelDbContext LayoutDb
@{
    var role = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value;
    var signedIn = User.Identity?.IsAuthenticated == true;

    // ลูกค้า: ผลคำขอคืนเงินและการย้ายห้องที่ยังไม่ได้เปิดดู (จำไว้ 1 นาที ไม่ถามฐานข้อมูลทุกหน้า)
    var noticeCount = 0;
    if (role == "Customer" && int.TryParse(User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value, out var layoutUserId))
    {
        noticeCount = (await Notices.UnseenAsync(Context, LayoutDb, layoutUserId, Context.RequestAborted)).Total;
    }
    var action = ViewContext.RouteData.Values["Action"]?.ToString() ?? "";
    string Active(string name) => action.Equals(name, StringComparison.OrdinalIgnoreCase) ? "active" : "";

    // พนักงานที่เปิดหน้าเว็บลูกค้า: ลิงก์กลับไปหน้าทำงานของ role ตัวเอง (อยู่ในเมนูบัญชี)
    var workplace = role switch
    {
        "Admin" => ("Admin", "Dashboard", "Admin Management"),
        "Staff" => ("Staff", "Index", "Staff Management"),
        "Housekeeper" => ("Housekeeper", "Index", "Housekeeping Management"),
        "Accountant" => ("Accountant", "Index", "Accounting Management"),
        _ => ((string, string, string)?)null
    };
}
<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · Good Hotel</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Thai:wght@400;500;600;700&family=Noto+Serif+Thai:wght@600&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="hotel-body">
    <header class="top-header">
        <nav class="navbar navbar-expand-lg hotel-navbar">
            <div class="container">
                <a class="hotel-brand" asp-controller="Home" asp-action="Index">Good Hotel</a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar"
                        aria-controls="mainNavbar" aria-expanded="false" aria-label="เปิดเมนู">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNavbar">
                    <ul class="navbar-nav ms-lg-4 me-auto">
                        <li class="nav-item"><a class="nav-link @Active("Rooms") @Active("RoomDetails")" asp-controller="Home" asp-action="Rooms">ห้องพัก</a></li>
                        <li class="nav-item"><a class="nav-link @Active("Promotion")" asp-controller="Home" asp-action="Promotion">โปรโมชัน</a></li>
                        <li class="nav-item"><a class="nav-link @Active("About")" asp-controller="Home" asp-action="About">เกี่ยวกับเรา</a></li>
                        @if (role == "Customer")
                        {
                            <li class="nav-item"><a class="nav-link @Active("MyBookings")" asp-controller="Home" asp-action="MyBookings">
                                <span>การจองของฉัน</span>
                                @if (noticeCount > 0)
                                {
                                    <span class="badge rounded-pill text-bg-danger ms-1" title="มีเรื่องใหม่เกี่ยวกับการจองของคุณ">@noticeCount<span class="visually-hidden"> เรื่องใหม่</span></span>
                                }
                            </a></li>
                        }
                    </ul>

                    <div class="d-flex align-items-center gap-3 mt-3 mt-lg-0">
                        @if (signedIn)
                        {
                            var fullName = UserDirectory.DisplayName(User);
                            <div class="dropdown account-menu">
                                <button class="account-toggle dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <span class="bo-avatar" aria-hidden="true">@UserDirectory.Initial(fullName)</span>
                                    <span class="account-text">
                                        <span class="account-name">@fullName</span>
                                        <span class="account-role">@ThaiText.Status(role)</span>
                                    </span>
                                </button>
                                <div class="dropdown-menu dropdown-menu-end">
                                    <div class="account-email">@User.Identity!.Name</div>
                                    <div class="dropdown-divider"></div>
                                    @if (workplace is { } place)
                                    {
                                        <a class="dropdown-item account-work" asp-controller="@place.Item1" asp-action="@place.Item2">@place.Item3</a>
                                    }
                                    <a class="dropdown-item" asp-controller="Account" asp-action="@(role == "Customer" ? "Profile" : "Password")">@(role == "Customer" ? "บัญชีของฉัน" : "เปลี่ยนรหัสผ่าน")</a>
                                    <form asp-controller="Home" asp-action="Logout" method="post" class="m-0">
                                        <button type="submit" class="dropdown-item account-logout">ออกจากระบบ</button>
                                    </form>
                                </div>
                            </div>
                        }
                        else
                        {
                            <a class="btn btn-sm btn-outline-primary" asp-controller="Home" asp-action="Login">เข้าสู่ระบบ</a>
                            <a class="btn btn-sm btn-primary" asp-controller="Home" asp-action="Register">สมัครสมาชิก</a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <main>
        @RenderBody()
        @* ปุ่มหัวหน้า (Actions) มีเฉพาะหลังบ้าน หน้าที่ลูกค้าก็เปิดได้ (เช่นการชำระเงิน) ให้ข้ามไป *@
        @if (IsSectionDefined("Actions")) { IgnoreSection("Actions"); }
    </main>

    <footer class="hotel-footer">
        <div class="container">
            <div class="row gy-3">
                <div class="col-md-4">
                    <a class="hotel-brand" asp-controller="Home" asp-action="Index">Good Hotel</a>
                    <p class="footer-copy mt-1">86 ถนนสุขุมวิท กรุงเทพฯ</p>
                </div>
                <div class="col-6 col-md-4">
                    <h6>โทรศัพท์</h6>
                    <p class="footer-copy">02 555 8900</p>
                </div>
                <div class="col-6 col-md-4">
                    <h6>อีเมล</h6>
                    <p class="footer-copy">hello@goodhotel.com</p>
                </div>
            </div>
            <div class="footer-bottom">
                <span>© 2026 Good Hotel</span>
            </div>
        </div>
    </footer>

    @* ชี้เมาส์ที่เมนูแล้วโหลดหน้ารอไว้ กดแล้วเปิดทันที (เฉพาะหน้าที่เปิดดูอย่างเดียว ไม่รวมการจองของฉัน เพราะเปิดแล้วนับว่าอ่านแจ้งเตือน) *@
    <script type="speculationrules">
        { "prefetch": [{ "where": { "selector_matches": ".hotel-brand, .hotel-navbar .nav-link[href*='Rooms'], .hotel-navbar .nav-link[href*='Promotion'], .hotel-navbar .nav-link[href*='About'], a[href*='/Home/RoomDetails/']" }, "eagerness": "moderate" }] }
    </script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
