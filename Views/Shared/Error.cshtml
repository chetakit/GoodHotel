@model ErrorViewModel
@{
    ViewData["Title"] = "เกิดข้อผิดพลาด";
}

<section class="content-section">
    <div class="container">
        <div class="auth-card">
            <h2 class="mb-2">เกิดข้อผิดพลาด</h2>
            <p class="text-muted">ระบบทำรายการนี้ไม่สำเร็จ ลองใหม่อีกครั้ง ถ้ายังไม่ได้ให้แจ้งผู้ดูแลระบบ</p>
            @if (Model.ShowRequestId)
            {
                <p class="small text-muted">รหัสอ้างอิง: <code>@Model.RequestId</code></p>
            }
            <a asp-controller="Home" asp-action="Index" class="btn btn-primary">กลับหน้าแรก</a>
        </div>
    </div>
</section>
