@model IReadOnlyList<GoodHotel.Models.ViewModels.LedgerEntry>
@* ตารางสมุดรายวัน ใช้ทั้งหน้าภาพรวมและหน้าปิดยอด *@
<div class="table-responsive">
    <table class="table table-hover">
        <thead>
            <tr>
                <th>เวลา</th>
                <th>รายการ</th>
                <th>การจอง</th>
                <th>ลูกค้า</th>
                <th>ช่องทาง</th>
                <th>ผู้ยืนยัน/อนุมัติ</th>
                <th class="text-end">จำนวนเงิน</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var entry in Model)
            {
                <tr>
                    <td class="num">@ThaiText.Time(entry.OccurredAtUtc)</td>
                    <td>
                        @if (entry.IsRefund)
                        {
                            <span class="badge text-bg-danger">คืนเงิน</span>
                        }
                        else
                        {
                            <span class="badge text-bg-success">รับเงิน</span>
                        }
                    </td>
                    <td>
                        @if (entry.BookingId.HasValue)
                        {
                            <a asp-controller="Payment" asp-action="Details" asp-route-id="@entry.BookingId">#@entry.BookingId</a>
                        }
                        else
                        {
                            <span>-</span>
                        }
                    </td>
                    <td>@ThaiText.OrDash(entry.GuestName)</td>
                    <td>@ThaiText.PaymentMethod(entry.Method)</td>
                    <td>@ThaiText.OrDash(entry.ActorName)</td>
                    <td class="text-end num @(entry.IsRefund ? "money-out" : "")">
                        @(entry.IsRefund ? "−" : "")฿@entry.Amount.ToString("N2")
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
